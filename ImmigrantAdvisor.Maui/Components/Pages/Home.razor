@page "/"
@using ImmigrantAdvisor.Shared.Models
@using ImmigrantAdvisor.Shared.Services
@inject ImmigrationAdvisorService AdvisorService
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>مشاور مهاجرت هوشمند</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100">
    <!-- Header -->
    <div class="bg-gradient-to-l from-blue-600 via-indigo-600 to-violet-700 text-white">
        <div class="max-w-4xl mx-auto px-4 py-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl mb-4">
                <span class="text-3xl">🌍</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-bold mb-2">مشاور مهاجرت هوشمند</h1>
            <p class="text-blue-100 text-sm md:text-base">اطلاعات خود را وارد کنید تا بهترین گزینه‌های مهاجرتی را پیشنهاد دهیم</p>
        </div>
    </div>

    <!-- Stepper -->
    <div class="max-w-4xl mx-auto px-4 -mt-6">
        <div class="bg-white rounded-2xl shadow-lg p-4 md:p-6">
            <div class="flex items-center">
                @{
                    var stepLabels = new[] { "۱", "۲", "۳", "۴", "۵", "۶", "۷" };
                }
                @for (int i = 0; i < 7; i++)
                {
                    var idx = i;
                    <div class="flex items-center flex-1 @(idx == 6 ? "justify-start" : "")">
                        <button type="button" @onclick="() => GoToStep(idx)" class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-full text-sm font-bold transition-all duration-300 shrink-0
                            @(idx == currentStep ? "bg-indigo-600 text-white shadow-lg shadow-indigo-200 scale-110" : (idx < currentStep ? "bg-green-500 text-white" : "bg-gray-100 text-gray-400"))">
                            @if (idx == currentStep)
                            {
                                @stepLabels[idx]
                            }
                            else if (idx < currentStep)
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                @stepLabels[idx]
                            }
                        </button>
                        @if (idx < 6)
                        {
                            <div class="flex-1 mx-1 md:mx-2 h-1 rounded-full overflow-hidden bg-gray-100">
                                <div class="h-full rounded-full transition-all duration-500 @(idx < currentStep ? "bg-green-500 w-full" : "bg-gray-100 w-0")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mt-3 text-center">
                <span class="text-sm font-medium text-indigo-600">@stepTitles[currentStep]</span>
                <span class="text-xs text-gray-400 mr-2">مرحله @(currentStep + 1) از ۷</span>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="max-w-4xl mx-auto px-4 py-6 pb-24">
        <EditForm Model="@factors" OnValidSubmit="@HandleSubmit" FormName="ImmigrationForm">
            <DataAnnotationsValidator />
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="p-6 md:p-8">

                    @* ===== Step 1: Personal Info ===== *@
                    <div class="@(currentStep == 0 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">👤</div>
                            <div><h3 class="text-lg font-bold text-gray-800">اطلاعات شخصی</h3><p class="text-sm text-gray-400">اطلاعات پایه خود را وارد کنید</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🎂 سن</label><InputNumber @bind-Value="factors.Age" class="wizard-input ltr-input" min="18" max="80" placeholder="مثلاً 30" /></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">👤 جنسیت</label><InputSelect @bind-Value="factors.Gender" class="wizard-input"><option value="Male">مرد</option><option value="Female">زن</option><option value="PreferNotToSay">ترجیح نمی‌دهم</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">💍 وضعیت تأهل</label><InputSelect @bind-Value="factors.MaritalStatus" class="wizard-input" @onchange="OnMaritalStatusChanged"><option value="Single">مجرد</option><option value="Married">متأهل</option><option value="Divorced">مطلقه</option><option value="Widowed">همسر فوت شده</option></InputSelect></div>
                        </div>
                        @if (factors.MaritalStatus == MaritalStatus.Married)
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100">
                                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">👶 تعداد فرزندان</label><InputNumber @bind-Value="factors.NumberOfChildren" class="wizard-input ltr-input" min="0" max="10" /></div>
                                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">💼 همسر شاغل است؟</label><InputSelect @bind-Value="factors.SpouseWorking" class="wizard-input"><option value="true">بله</option><option value="false">خیر</option></InputSelect></div>
                            </div>
                        }
                    </div>

                    @* ===== Step 2: Education & Language ===== *@
                    <div class="@(currentStep == 1 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">🎓</div>
                            <div><h3 class="text-lg font-bold text-gray-800">تحصیلات و زبان</h3><p class="text-sm text-gray-400">سطح تحصیلات و مهارت‌های زبانی</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">📜 مقطع تحصیلی</label><InputSelect @bind-Value="factors.Education" class="wizard-input"><option value="NoFormalEducation">بدون تحصیلات</option><option value="HighSchool">دیپلم</option><option value="AssociateDegree">فوق دیپلم</option><option value="BachelorDegree">لیسانس</option><option value="MasterDegree">فوق لیسانس</option><option value="PhD">دکترا</option><option value="PostDoctoral">پسادکترا</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">📚 رشته تحصیلی</label><InputText @bind-Value="factors.FieldOfStudy" class="wizard-input" placeholder="مثال: مهندسی کامپیوتر" /></div>
                        </div>
                        <h4 class="text-sm font-semibold text-gray-500 mt-6 mb-4 flex items-center gap-2"><span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center">🗣</span>مهارت‌های زبانی</h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🇬🇧 انگلیسی</label><InputSelect @bind-Value="factors.EnglishLevel" class="wizard-input"><option value="None">هیچ</option><option value="Basic">مقدماتی</option><option value="Intermediate">متوسط</option><option value="Advanced">پیشرفته</option><option value="Native">مادری</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🇫🇷 فرانسوی</label><InputSelect @bind-Value="factors.FrenchLevel" class="wizard-input"><option value="None">هیچ</option><option value="Basic">مقدماتی</option><option value="Intermediate">متوسط</option><option value="Advanced">پیشرفته</option><option value="Native">مادری</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🇩🇪 آلمانی</label><InputSelect @bind-Value="factors.GermanLevel" class="wizard-input"><option value="None">هیچ</option><option value="Basic">مقدماتی</option><option value="Intermediate">متوسط</option><option value="Advanced">پیشرفته</option><option value="Native">مادری</option></InputSelect></div>
                        </div>
                    </div>

                    @* ===== Step 3: Work ===== *@
                    <div class="@(currentStep == 2 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">💼</div>
                            <div><h3 class="text-lg font-bold text-gray-800">شغل و تخصص</h3><p class="text-sm text-gray-400">وضعیت شغلی فعلی</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🏢 شغل فعلی</label><InputText @bind-Value="factors.Occupation" class="wizard-input" placeholder="مثال: مهندس نرم‌افزار" /></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">📅 سابقه کار (سال)</label><InputNumber @bind-Value="factors.YearsOfExperience" class="wizard-input ltr-input" min="0" max="50" /></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">📋 نوع اشتغال</label><InputSelect @bind-Value="factors.CurrentEmployment" class="wizard-input"><option value="Unemployed">بیکار</option><option value="PartTime">پاره‌وقت</option><option value="FullTime">تمام‌وقت</option><option value="SelfEmployed">خوداشتغال</option><option value="BusinessOwner">صاحب کسب‌وکار</option><option value="Retired">بازنشسته</option><option value="Student">دانشجو</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">💵 درآمد سالانه (دلار)</label><InputNumber @bind-Value="factors.AnnualIncomeUSD" class="wizard-input ltr-input" min="0" step="1000" placeholder="مثلاً 25000" /></div>
                        </div>
                    </div>

                    @* ===== Step 4: Financial ===== *@
                    <div class="@(currentStep == 3 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">💰</div>
                            <div><h3 class="text-lg font-bold text-gray-800">وضعیت مالی</h3><p class="text-sm text-gray-400">اطلاعات مالی برای پیشنهاد بهترین ویزا</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🏠 ارزش خالص دارایی‌ها (دلار)</label><InputNumber @bind-Value="factors.NetWorthUSD" class="wizard-input ltr-input" min="0" step="10000" placeholder="مثلاً 200000" /></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🏦 پس‌انداز سالانه (دلار)</label><InputNumber @bind-Value="factors.AnnualSavingsUSD" class="wizard-input ltr-input" min="0" step="5000" placeholder="مثلاً 10000" /></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
                            <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all @(factors.HasInvestmentProperty ? "border-indigo-500 bg-indigo-50" : "border-gray-200 hover:border-gray-300")">
                                <InputCheckbox @bind-Value="factors.HasInvestmentProperty" class="w-5 h-5 text-indigo-600 rounded" />
                                <div><span class="font-medium text-gray-700">🏗️ ملک سرمایه‌گذاری</span><p class="text-xs text-gray-400 mt-0.5">مالکیت ملک یا مستغلات</p></div>
                            </label>
                            <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all @(factors.HasBusinessOwnership ? "border-indigo-500 bg-indigo-50" : "border-gray-200 hover:border-gray-300")">
                                <InputCheckbox @bind-Value="factors.HasBusinessOwnership" class="w-5 h-5 text-indigo-600 rounded" />
                                <div><span class="font-medium text-gray-700">🏪 کسب‌وکار</span><p class="text-xs text-gray-400 mt-0.5">مالکیت یا شراکت در کسب‌وکار</p></div>
                            </label>
                        </div>
                    </div>

                    @* ===== Step 5: Health ===== *@
                    <div class="@(currentStep == 4 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">🏥</div>
                            <div><h3 class="text-lg font-bold text-gray-800">سلامت جسمی و روانی</h3><p class="text-sm text-gray-400">وضعیت سلامت شما</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">❤️ سلامت جسمی</label><InputSelect @bind-Value="factors.PhysicalHealth" class="wizard-input"><option value="Excellent">عالی</option><option value="Good">خوب</option><option value="Fair">متوسط</option><option value="Poor">ضعیف</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🧠 سلامت روانی</label><InputSelect @bind-Value="factors.MentalHealth" class="wizard-input"><option value="Excellent">عالی</option><option value="Good">خوب</option><option value="Fair">متوسط</option><option value="NeedsSupport">نیاز به حمایت</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">⚡ تحمل استرس</label><InputSelect @bind-Value="factors.StressTolerance" class="wizard-input"><option value="Low">کم</option><option value="Medium">متوسط</option><option value="High">بالا</option><option value="VeryHigh">خیلی بالا</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🔄 انعطاف‌پذیری</label><InputSelect @bind-Value="factors.Adaptability" class="wizard-input"><option value="Low">کم</option><option value="Medium">متوسط</option><option value="High">بالا</option><option value="VeryHigh">خیلی بالا</option></InputSelect></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
                            <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all @(factors.HasChronicDisease ? "border-amber-500 bg-amber-50" : "border-gray-200 hover:border-gray-300")">
                                <InputCheckbox @bind-Value="factors.HasChronicDisease" class="w-5 h-5 text-amber-600 rounded" /><span class="font-medium text-gray-700">🩺 بیماری مزمن</span>
                            </label>
                            <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all @(factors.NeedsSpecializedHealthcare ? "border-amber-500 bg-amber-50" : "border-gray-200 hover:border-gray-300")">
                                <InputCheckbox @bind-Value="factors.NeedsSpecializedHealthcare" class="w-5 h-5 text-amber-600 rounded" /><span class="font-medium text-gray-700">🏥 نیاز به مراقبت ویژه</span>
                            </label>
                        </div>
                    </div>

                    @* ===== Step 6: Social & Cultural ===== *@
                    <div class="@(currentStep == 5 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">🤝</div>
                            <div><h3 class="text-lg font-bold text-gray-800">اجتماعی و فرهنگی</h3><p class="text-sm text-gray-400">ترجیحات فرهنگی و اجتماعی</p></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🎭 ترجیح فرهنگی</label><InputSelect @bind-Value="factors.CulturalPreference" class="wizard-input"><option value="Western">غربی</option><option value="Eastern">شرقی</option><option value="MiddleEastern">خاورمیانه‌ای</option><option value="Multicultural">چندفرهنگی</option><option value="NoPreference">بدون ترجیح</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🕌 ترجیح مذهبی</label><InputSelect @bind-Value="factors.ReligionPreference" class="wizard-input"><option value="Muslim">مسلمان</option><option value="Christian">مسیحی</option><option value="Jewish">یهودی</option><option value="Other">سایر</option><option value="NoPreference">بدون ترجیح</option><option value="Secular">سکولار</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🏛️ اهمیت ثبات سیاسی</label><InputSelect @bind-Value="factors.ImportanceOfPoliticalStability" class="wizard-input"><option value="NotImportant">مهم نیست</option><option value="SomewhatImportant">تا حدی مهم</option><option value="Important">مهم</option><option value="VeryImportant">خیلی مهم</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">👥 ترجیح جامعه</label><InputSelect @bind-Value="factors.CommunityPreference" class="wizard-input"><option value="LargeIranianCommunity">جامعه بزرگ ایرانی</option><option value="SmallIranianCommunity">جامعه کوچک ایرانی</option><option value="NoPreference">بدون ترجیح</option><option value="PreferDiverseCommunity">ترجیح جامعه متنوع</option></InputSelect></div>
                        </div>
                        <div class="mt-5 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100">
                            <label class="flex items-center gap-3 cursor-pointer"><InputCheckbox @bind-Value="factors.HasRelativesAbroad" class="w-5 h-5 text-indigo-600 rounded" /><span class="font-medium text-gray-700">👨‍👩‍👧‍👦 خویشاوند در خارج دارم</span></label>
                            @if (factors.HasRelativesAbroad)
                            {
                                <div class="mt-3"><InputText @bind-Value="factors.RelativesCountries" class="wizard-input" placeholder="کشورهای محل اقامت خویشاوندان" /></div>
                            }
                        </div>
                    </div>

                    @* ===== Step 7: Goals & Preferences ===== *@
                    <div class="@(currentStep == 6 ? "" : "hidden")">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 bg-gradient-to-bl from-indigo-500 to-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200">🎯</div>
                            <div><h3 class="text-lg font-bold text-gray-800">اهداف و ترجیحات</h3><p class="text-sm text-gray-400">اهداف مهاجرتی و ترجیحات جغرافیایی</p></div>
                        </div>
                        <h4 class="text-sm font-semibold text-gray-500 mb-3">اهداف اصلی (چند مورد)</h4>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-6">
                            @{
                                var goals = new (string Value, string Label)[] {
                                    ("BetterEconomicOpportunities", "💵 فرصت اقتصادی"), ("HigherQualityOfLife", "✨ کیفیت زندگی"),
                                    ("Education", "🎓 تحصیل"), ("CareerGrowth", "📈 رشد شغلی"), ("FamilyReunification", "👨‍👩‍👧 پیوند خانواده"),
                                    ("PoliticalStability", "🏛️ ثبات سیاسی"), ("Safety", "🛡️ امنیت"), ("Healthcare", "🏥 بهداشت"),
                                    ("Retirement", "🌴 بازنشستگی"), ("BusinessExpansion", "🏪 توسعه کسب‌وکار"), ("CulturalExperience", "🎭 تجربه فرهنگی")
                                };
                            }
                            @foreach (var g in goals)
                            {
                                var goalEnum = (MigrationGoal)Enum.Parse(typeof(MigrationGoal), g.Value);
                                <label class="flex items-center gap-2 p-3 rounded-xl border-2 cursor-pointer transition-all text-sm @(factors.Goals.Contains(goalEnum) ? "border-indigo-500 bg-indigo-50 text-indigo-700" : "border-gray-200 hover:border-gray-300 text-gray-600")">
                                    <input type="checkbox" class="w-4 h-4 text-indigo-600 rounded" checked="@factors.Goals.Contains(goalEnum)" @onchange="@(e => ToggleGoal(goalEnum, (bool)e.Value!))" /> @g.Label
                                </label>
                            }
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">⏰ زمان‌بندی</label><InputSelect @bind-Value="factors.PreferredTimeline" class="wizard-input"><option value="Immediate">فوری</option><option value="Within3Months">تا ۳ ماه</option><option value="Within6Months">تا ۶ ماه</option><option value="Within1Year">تا ۱ سال</option><option value="Within2Years">تا ۲ سال</option><option value="Flexible">انعطاف‌پذیر</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🌤️ آب‌وهوا</label><InputSelect @bind-Value="factors.ClimatePreference" class="wizard-input"><option value="Tropical">گرمسیری</option><option value="Temperate">معتدل</option><option value="Mediterranean">مدیترانه‌ای</option><option value="Continental">قاره‌ای</option><option value="Cold">سرد</option><option value="NoPreference">بدون ترجیح</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">🏙️ شهری/روستایی</label><InputSelect @bind-Value="factors.UrbanRuralPreference" class="wizard-input"><option value="BigCity">شهر بزرگ</option><option value="MediumCity">شهر متوسط</option><option value="SmallTown">شهر کوچک</option><option value="Rural">روستا</option><option value="NoPreference">بدون ترجیح</option></InputSelect></div>
                            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">📏 فاصله از ایران</label><InputSelect @bind-Value="factors.DistancePreference" class="wizard-input"><option value="VeryClose">خیلی نزدیک</option><option value="Close">نزدیک</option><option value="Moderate">متوسط</option><option value="Far">دور</option><option value="NoPreference">بدون ترجیح</option></InputSelect></div>
                        </div>
                        <label class="flex items-center gap-3 mt-5 p-4 rounded-xl border-2 cursor-pointer transition-all @(factors.SeekingCitizenship ? "border-green-500 bg-green-50" : "border-gray-200 hover:border-gray-300")">
                            <InputCheckbox @bind-Value="factors.SeekingCitizenship" class="w-5 h-5 text-green-600 rounded" /><span class="font-medium text-gray-700">🛂 به دنبال تابعیت هستم</span>
                        </label>
                        @if (factors.NumberOfChildren > 0)
                        {
                            <div class="mt-5 p-4 bg-violet-50/50 rounded-xl border border-violet-100">
                                <h4 class="text-sm font-semibold text-violet-600 mb-3">👨‍👩‍👧‍👦 فرزندان و آموزش</h4>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <label class="flex items-center gap-3 cursor-pointer"><InputCheckbox @bind-Value="factors.ChildrenEducationImportant" class="w-5 h-5 text-violet-600 rounded" /><span class="text-sm text-gray-700">آموزش فرزندان مهم است</span></label>
                                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">سن بزرگترین فرزند</label><InputSelect @bind-Value="factors.EldestChildAge" class="wizard-input"><option value="Infant">نوزاد (۰-۲)</option><option value="Child">کودک (۳-۱۲)</option><option value="Teenager">نوجوان (۱۳-۱۷)</option><option value="YoungAdult">جوان (۱۸-۲۵)</option><option value="Adult">بزرگسال</option></InputSelect></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Navigation - Bottom Docked -->
                <div class="fixed bottom-0 left-0 right-0 border-t border-gray-100 px-6 md:px-8 py-4 bg-white shadow-lg z-50">
                    <div class="max-w-4xl mx-auto flex justify-between items-center">
                        <button type="button" @onclick="PrevStep" class="flex items-center justify-center w-10 h-10 text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 transition-all @(currentStep == 0 ? "invisible" : "")" title="مرحله قبل">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
                        </button>
                        <button type="button" @onclick="ClearForm" class="flex items-center justify-center w-10 h-10 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all" title="پاک کردن فرم">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                        @if (currentStep < 6)
                        {
                            <button type="button" @onclick="NextStep" class="flex items-center justify-center w-10 h-10 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200" title="مرحله بعد">
                                <svg class="w-5 h-5 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="flex items-center gap-2 px-8 py-3 bg-gradient-to-l from-green-500 to-emerald-600 text-white rounded-xl hover:from-green-600 hover:to-emerald-700 transition-all font-bold text-sm shadow-lg shadow-green-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                دریافت پیشنهادات مهاجرتی
                            </button>
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private UserFactors factors = new();
    private int currentStep = 0;
    private string[] stepTitles = { "اطلاعات شخصی", "تحصیلات و زبان", "شغل و تخصص", "وضعیت مالی", "سلامت و روان", "اجتماعی و فرهنگی", "اهداف و ترجیحات" };
    
    protected override void OnInitialized()
    {
        // Load from AppState if exists
        if (AppState.UserFactors.Age > 0)
        {
            factors = AppState.UserFactors;
        }
    }

    private void GoToStep(int step)
    {
        if (step <= currentStep)
        {
            currentStep = step;
        }
    }

    private void NextStep()
    {
        if (currentStep < 6)
        {
            currentStep++;
        }
    }

    private void PrevStep()
    {
        if (currentStep > 0)
        {
            currentStep--;
        }
    }

    private void ClearForm()
    {
        factors = new UserFactors();
        currentStep = 0;
    }

    private void OnMaritalStatusChanged()
    {
        // Trigger re-render when marital status changes
        StateHasChanged();
    }

    private void ToggleGoal(MigrationGoal goal, bool isChecked)
    {
        if (isChecked && !factors.Goals.Contains(goal))
        {
            factors.Goals.Add(goal);
        }
        else if (!isChecked && factors.Goals.Contains(goal))
        {
            factors.Goals.Remove(goal);
        }
    }

    private string GetGoalName(MigrationGoal goal) => goal switch
    {
        MigrationGoal.BetterEconomicOpportunities => "فرصت‌های اقتصادی بهتر",
        MigrationGoal.HigherQualityOfLife => "کیفیت زندگی بالاتر",
        MigrationGoal.Education => "آموزش و تحصیل",
        MigrationGoal.CareerGrowth => "رشد شغلی",
        MigrationGoal.FamilyReunification => "پیوند مجدد خانواده",
        MigrationGoal.PoliticalStability => "ثبات سیاسی",
        MigrationGoal.Safety => "امنیت",
        MigrationGoal.Healthcare => "بهداشت و درمان",
        MigrationGoal.Retirement => "بازنشستگی",
        MigrationGoal.BusinessExpansion => "توسعه کسب‌وکار",
        MigrationGoal.CulturalExperience => "تجربه فرهنگی",
        _ => goal.ToString()
    };

    private void HandleSubmit()
    {
        // Save to AppState
        AppState.UserFactors = factors;
        AppState.Results = AdvisorService.GetRecommendations(factors);
        NavigationManager.NavigateTo("/results");
    }
}
