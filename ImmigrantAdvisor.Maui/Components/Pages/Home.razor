@page "/"
@using ImmigrantAdvisor.Shared.Models
@using ImmigrantAdvisor.Shared.Services
@inject ImmigrationAdvisorService AdvisorService
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>مشاور مهاجرت هوشمند</PageTitle>

<div class="max-w-7xl mx-auto px-4 py-6">
    <div class="flex justify-center">
        <div class="w-full max-w-5xl">
            <div class="bg-white rounded-2xl shadow-xl">
                <div class="bg-blue-600 text-white text-center rounded-t-2xl py-4 px-6">
                    <h2 class="mb-0">🌍 مشاور مهاجرت هوشمند</h2>
                    <p class="mb-0 mt-2">اطلاعات خود را وارد کنید تا بهترین گزینه‌های مهاجرتی را به شما پیشنهاد دهیم</p>
                </div>
                <div class="p-6">
                    <EditForm Model="@factors" OnValidSubmit="@HandleSubmit" FormName="ImmigrationForm">
                        <DataAnnotationsValidator />
                        
                        <!-- اطلاعات شخصی -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">👤 اطلاعات شخصی</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/3 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سن</label>
                                    <InputNumber @bind-Value="factors.Age" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="18" max="80" />
                                </div>
                                <div class="w-full md:w-1/3 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">جنسیت</label>
                                    <InputSelect @bind-Value="factors.Gender" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@Gender.Male">مرد</option>
                                        <option value="@Gender.Female">زن</option>
                                        <option value="@Gender.PreferNotToSay">ترجیح می‌دهم نگویم</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/3 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">وضعیت تأهل</label>
                                    <InputSelect @bind-Value="factors.MaritalStatus" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@MaritalStatus.Single">مجرد</option>
                                        <option value="@MaritalStatus.Married">متأهل</option>
                                        <option value="@MaritalStatus.Divorced">مطلقه</option>
                                        <option value="@MaritalStatus.Widowed">همسر فوت شده</option>
                                    </InputSelect>
                                </div>
                                @if (factors.MaritalStatus == MaritalStatus.Married)
                                {
                                    <div class="w-full md:w-1/2 px-3">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">تعداد فرزندان</label>
                                        <InputNumber @bind-Value="factors.NumberOfChildren" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="0" max="10" />
                                    </div>
                                    <div class="w-full md:w-1/2 px-3">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">همسر شاغل است؟</label>
                                        <InputSelect @bind-Value="factors.SpouseWorking" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                            <option value="true">بله</option>
                                            <option value="false">خیر</option>
                                        </InputSelect>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- تحصیلات و زبان -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">🎓 تحصیلات و زبان</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">مقطع تحصیلی</label>
                                    <InputSelect @bind-Value="factors.Education" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@EducationLevel.NoFormalEducation">بدون تحصیلات رسمی</option>
                                        <option value="@EducationLevel.HighSchool">دیپلم</option>
                                        <option value="@EducationLevel.AssociateDegree">فوق دیپلم</option>
                                        <option value="@EducationLevel.BachelorDegree">لیسانس</option>
                                        <option value="@EducationLevel.MasterDegree">فوق لیسانس</option>
                                        <option value="@EducationLevel.PhD">دکترا</option>
                                        <option value="@EducationLevel.PostDoctoral">پسادکترا</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">رشته تحصیلی</label>
                                    <InputText @bind-Value="factors.FieldOfStudy" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="مثال: مهندسی کامپیوتر" />
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سطح زبان انگلیسی</label>
                                    <InputSelect @bind-Value="factors.EnglishLevel" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@LanguageProficiency.None">هیچ</option>
                                        <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                        <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                        <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                        <option value="@LanguageProficiency.Native">مادری</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سطح زبان فرانسوی</label>
                                    <InputSelect @bind-Value="factors.FrenchLevel" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@LanguageProficiency.None">هیچ</option>
                                        <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                        <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                        <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                        <option value="@LanguageProficiency.Native">مادری</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سطح زبان آلمانی</label>
                                    <InputSelect @bind-Value="factors.GermanLevel" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@LanguageProficiency.None">هیچ</option>
                                        <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                        <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                        <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                        <option value="@LanguageProficiency.Native">مادری</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <!-- شغل و تخصص -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">💼 شغل و تخصص</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">شغل فعلی</label>
                                    <InputText @bind-Value="factors.Occupation" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="مثال: مهندس نرم‌افزار" />
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سابقه کار (سال)</label>
                                    <InputNumber @bind-Value="factors.YearsOfExperience" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="0" max="50" />
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">نوع اشتغال</label>
                                    <InputSelect @bind-Value="factors.CurrentEmployment" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@EmploymentType.Unemployed">بیکار</option>
                                        <option value="@EmploymentType.PartTime">پاره‌وقت</option>
                                        <option value="@EmploymentType.FullTime">تمام‌وقت</option>
                                        <option value="@EmploymentType.SelfEmployed">خوداشتغال</option>
                                        <option value="@EmploymentType.BusinessOwner">صاحب کسب‌وکار</option>
                                        <option value="@EmploymentType.Retired">بازنشسته</option>
                                        <option value="@EmploymentType.Student">دانشجو</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">درآمد سالانه (دلار)</label>
                                    <InputNumber @bind-Value="factors.AnnualIncomeUSD" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="0" step="1000" />
                                </div>
                            </div>
                        </div>

                        <!-- وضعیت مالی -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">💰 وضعیت مالی</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ارزش خالص دارایی‌ها (دلار)</label>
                                    <InputNumber @bind-Value="factors.NetWorthUSD" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="0" step="10000" />
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">پس‌انداز سالانه (دلار)</label>
                                    <InputNumber @bind-Value="factors.AnnualSavingsUSD" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" min="0" step="5000" />
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.HasInvestmentProperty" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">مالکیت ملک سرمایه‌گذاری</label>
                                    </div>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.HasBusinessOwnership" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">مالکیت کسب‌وکار</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- سلامت و روان -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">🏥 سلامت جسمی و روانی</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سلامت جسمی</label>
                                    <InputSelect @bind-Value="factors.PhysicalHealth" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@PhysicalHealthStatus.Excellent">عالی</option>
                                        <option value="@PhysicalHealthStatus.Good">خوب</option>
                                        <option value="@PhysicalHealthStatus.Fair">متوسط</option>
                                        <option value="@PhysicalHealthStatus.Poor">ضعیف</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">سلامت روانی</label>
                                    <InputSelect @bind-Value="factors.MentalHealth" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@MentalHealthStatus.Excellent">عالی</option>
                                        <option value="@MentalHealthStatus.Good">خوب</option>
                                        <option value="@MentalHealthStatus.Fair">متوسط</option>
                                        <option value="@MentalHealthStatus.NeedsSupport">نیاز به حمایت</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">تحمل استرس</label>
                                    <InputSelect @bind-Value="factors.StressTolerance" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@StressToleranceLevel.Low">کم</option>
                                        <option value="@StressToleranceLevel.Medium">متوسط</option>
                                        <option value="@StressToleranceLevel.High">بالا</option>
                                        <option value="@StressToleranceLevel.VeryHigh">خیلی بالا</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">انعطاف‌پذیری و سازگاری</label>
                                    <InputSelect @bind-Value="factors.Adaptability" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@AdaptabilityLevel.Low">کم</option>
                                        <option value="@AdaptabilityLevel.Medium">متوسط</option>
                                        <option value="@AdaptabilityLevel.High">بالا</option>
                                        <option value="@AdaptabilityLevel.VeryHigh">خیلی بالا</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.HasChronicDisease" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">بیماری مزمن</label>
                                    </div>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.NeedsSpecializedHealthcare" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">نیاز به مراقبت‌های ویژه</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- اجتماعی و فرهنگی -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">🤝 اجتماعی و فرهنگی</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.HasRelativesAbroad" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">اقامت خویشاوندان در خارج</label>
                                    </div>
                                </div>
                                @if (factors.HasRelativesAbroad)
                                {
                                    <div class="w-full md:w-1/2 px-3">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">کشورهای محل اقامت خویشاوندان</label>
                                        <InputText @bind-Value="factors.RelativesCountries" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="مثال: کانادا، آلمان" />
                                    </div>
                                }
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح فرهنگی</label>
                                    <InputSelect @bind-Value="factors.CulturalPreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@CulturalPreference.Western">غربی</option>
                                        <option value="@CulturalPreference.Eastern">شرقی</option>
                                        <option value="@CulturalPreference.MiddleEastern">خاورمیانه‌ای</option>
                                        <option value="@CulturalPreference.Multicultural">چندفرهنگی</option>
                                        <option value="@CulturalPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح مذهبی</label>
                                    <InputSelect @bind-Value="factors.ReligionPreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@ReligionPreference.Muslim">مسلمان</option>
                                        <option value="@ReligionPreference.Christian">مسیحی</option>
                                        <option value="@ReligionPreference.Jewish">یهودی</option>
                                        <option value="@ReligionPreference.Other">سایر</option>
                                        <option value="@ReligionPreference.NoPreference">بدون ترجیح</option>
                                        <option value="@ReligionPreference.Secular">سکولار</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">اهمیت ثبات سیاسی</label>
                                    <InputSelect @bind-Value="factors.ImportanceOfPoliticalStability" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@ImportanceOfPoliticalStability.NotImportant">مهم نیست</option>
                                        <option value="@ImportanceOfPoliticalStability.SomewhatImportant">تا حدی مهم</option>
                                        <option value="@ImportanceOfPoliticalStability.Important">مهم</option>
                                        <option value="@ImportanceOfPoliticalStability.VeryImportant">خیلی مهم</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح جامعه</label>
                                    <InputSelect @bind-Value="factors.CommunityPreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@CommunityIntegrationPreference.LargeIranianCommunity">جامعه بزرگ ایرانی</option>
                                        <option value="@CommunityIntegrationPreference.SmallIranianCommunity">جامعه کوچک ایرانی</option>
                                        <option value="@CommunityIntegrationPreference.NoPreference">بدون ترجیح</option>
                                        <option value="@CommunityIntegrationPreference.PreferDiverseCommunity">ترجیح جامعه متنوع</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <!-- اهداف مهاجرت -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">🎯 اهداف مهاجرت</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">اهداف اصلی (چند مورد انتخاب کنید)</label>
                                    <div class="flex flex-wrap -mx-3">
                                        @foreach (var goal in Enum.GetValues<MigrationGoal>())
                                        {
                                            <div class="w-full md:w-1/3 px-3">
                                                <div class="flex items-center gap-2">
                                                    <input type="checkbox" class="rounded h-4 w-4" 
                                                           checked="@factors.Goals.Contains(goal)"
                                                           @onchange="@(e => ToggleGoal(goal, (bool)e.Value!))" />
                                                    <label class="text-sm text-gray-700">@GetGoalName(goal)</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">زمان‌بندی ترجیحی</label>
                                    <InputSelect @bind-Value="factors.PreferredTimeline" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@MigrationTimeline.Immediate">فوری</option>
                                        <option value="@MigrationTimeline.Within3Months">تا ۳ ماه</option>
                                        <option value="@MigrationTimeline.Within6Months">تا ۶ ماه</option>
                                        <option value="@MigrationTimeline.Within1Year">تا ۱ سال</option>
                                        <option value="@MigrationTimeline.Within2Years">تا ۲ سال</option>
                                        <option value="@MigrationTimeline.Flexible">انعطاف‌پذیر</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <div class="flex items-center gap-2">
                                        <InputCheckbox @bind-Value="factors.SeekingCitizenship" class="rounded h-4 w-4" />
                                        <label class="text-sm text-gray-700">به دنبال دریافت تابعیت هستم</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ترجیحات جغرافیایی -->
                        <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                            <h4 class="text-blue-600">🗺️ ترجیحات جغرافیایی</h4>
                            <div class="flex flex-wrap -mx-3 gap-3">
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح آب‌وهوا</label>
                                    <InputSelect @bind-Value="factors.ClimatePreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@ClimatePreference.Tropical">گرمسیری</option>
                                        <option value="@ClimatePreference.Temperate">معتدل</option>
                                        <option value="@ClimatePreference.Mediterranean">مدیترانه‌ای</option>
                                        <option value="@ClimatePreference.Continental">قاره‌ای</option>
                                        <option value="@ClimatePreference.Cold">سرد</option>
                                        <option value="@ClimatePreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح شهری/روستایی</label>
                                    <InputSelect @bind-Value="factors.UrbanRuralPreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@UrbanRuralPreference.BigCity">شهر بزرگ</option>
                                        <option value="@UrbanRuralPreference.MediumCity">شهر متوسط</option>
                                        <option value="@UrbanRuralPreference.SmallTown">شهر کوچک</option>
                                        <option value="@UrbanRuralPreference.Rural">روستا</option>
                                        <option value="@UrbanRuralPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </div>
                                <div class="w-full md:w-1/2 px-3">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">ترجیح فاصله از ایران</label>
                                    <InputSelect @bind-Value="factors.DistancePreference" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                        <option value="@DistanceFromIranPreference.VeryClose">خیلی نزدیک</option>
                                        <option value="@DistanceFromIranPreference.Close">نزدیک</option>
                                        <option value="@DistanceFromIranPreference.Moderate">متوسط</option>
                                        <option value="@DistanceFromIranPreference.Far">دور</option>
                                        <option value="@DistanceFromIranPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <!-- فرزندان و آموزش -->
                        @if (factors.NumberOfChildren > 0)
                        {
                            <div class="bg-gray-50 border-r-4 border-blue-600 rounded-xl p-6 mb-6">
                                <h4 class="text-blue-600">👨‍👩‍👧‍👦 فرزندان و آموزش</h4>
                                <div class="flex flex-wrap -mx-3 gap-3">
                                    <div class="w-full md:w-1/2 px-3">
                                        <div class="flex items-center gap-2">
                                            <InputCheckbox @bind-Value="factors.ChildrenEducationImportant" class="rounded h-4 w-4" />
                                            <label class="text-sm text-gray-700">آموزش فرزندان برایم مهم است</label>
                                        </div>
                                    </div>
                                    <div class="w-full md:w-1/2 px-3">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">سن بزرگترین فرزند</label>
                                        <InputSelect @bind-Value="factors.EldestChildAge" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-blue-500 bg-white">
                                            <option value="@AgeGroup.Infant">نوزاد (۰-۲)</option>
                                            <option value="@AgeGroup.Child">کودک (۳-۱۲)</option>
                                            <option value="@AgeGroup.Teenager">نوجوان (۱۳-۱۷)</option>
                                            <option value="@AgeGroup.YoungAdult">جوان (۱۸-۲۵)</option>
                                            <option value="@AgeGroup.Adult">بزرگسال (+۲۵)</option>
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="flex flex-col gap-2">
                            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition-colors">
                                🔍 دریافت پیشنهادات مهاجرتی
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserFactors factors = new();
    
    protected override void OnInitialized()
    {
        // Load from AppState if exists
        if (AppState.UserFactors.Age > 0)
        {
            factors = AppState.UserFactors;
        }
    }

    private void ToggleGoal(MigrationGoal goal, bool isChecked)
    {
        if (isChecked && !factors.Goals.Contains(goal))
        {
            factors.Goals.Add(goal);
        }
        else if (!isChecked && factors.Goals.Contains(goal))
        {
            factors.Goals.Remove(goal);
        }
    }

    private string GetGoalName(MigrationGoal goal) => goal switch
    {
        MigrationGoal.BetterEconomicOpportunities => "فرصت‌های اقتصادی بهتر",
        MigrationGoal.HigherQualityOfLife => "کیفیت زندگی بالاتر",
        MigrationGoal.Education => "آموزش و تحصیل",
        MigrationGoal.CareerGrowth => "رشد شغلی",
        MigrationGoal.FamilyReunification => "پیوند مجدد خانواده",
        MigrationGoal.PoliticalStability => "ثبات سیاسی",
        MigrationGoal.Safety => "امنیت",
        MigrationGoal.Healthcare => "بهداشت و درمان",
        MigrationGoal.Retirement => "بازنشستگی",
        MigrationGoal.BusinessExpansion => "توسعه کسب‌وکار",
        MigrationGoal.CulturalExperience => "تجربه فرهنگی",
        _ => goal.ToString()
    };

    private void HandleSubmit()
    {
        // Save to AppState
        AppState.UserFactors = factors;
        AppState.Results = AdvisorService.GetRecommendations(factors);
        NavigationManager.NavigateTo("/results");
    }
}
