@page "/"
@using ImmigrantAdvisor.Shared.Models
@using ImmigrantAdvisor.Shared.Services
@inject ImmigrationAdvisorService AdvisorService
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>مشاور مهاجرت هوشمند</PageTitle>

<MudAppBar Color="Color.Primary" Elevation="3">
    <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Large" Class="ml-3" />
    <MudText Typo="Typo.h6" Class="ml-3">مشاور مهاجرت هوشمند</MudText>
    <MudSpacer />
    <MudText Typo="Typo.caption" Class="text-white">اطلاعات خود را وارد کنید</MudText>
</MudAppBar>

<!-- Stepper -->
<MudPaper Class="mx-4 mt-n5 pa-4" Elevation="4" Style="border-radius: 16px; z-index: 10; position: relative;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @for (int i = 0; i < 7; i++)
        {
            var idx = i;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex: 1;">
                <MudButton Variant="Variant.Text" Size="Size.Small" 
                           Style="min-width: 32px; width: 32px; height: 32px; border-radius: 50%; padding: 0; @(idx == currentStep ? "background: #3f51b5; color: white;" : (idx < currentStep ? "background: #4caf50; color: white;" : "background: #e0e0e0; color: #666;"))"
                           OnClick="@(() => GoToStep(idx))">
                    @if (idx < currentStep)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">@(idx + 1)</MudText>
                    }
                </MudButton>
                @if (idx < 6)
                {
                    <MudDivider Style="flex: 1;" />
                }
            </MudStack>
        }
    </MudStack>
    <MudText Typo="Typo.body2" Class="text-center mt-2" Style="color: #3f51b5;">
        <strong>@stepTitles[currentStep]</strong>
        <span class="text-grey ms-2">مرحله @(currentStep + 1) از ۷</span>
    </MudText>
</MudPaper>

<!-- Form -->
<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6 pb-24">
    <EditForm Model="@factors" OnValidSubmit="@HandleSubmit" FormName="ImmigrationForm">
        <DataAnnotationsValidator />
        <MudPaper Class="pa-6" Elevation="3" Style="border-radius: 16px;">

            @* ===== Step 1: Personal Info ===== *@
            <div class="@(currentStep == 0 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">اطلاعات شخصی</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">اطلاعات پایه خود را وارد کنید</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="int?" @bind-Value="factors.Age" Label="🎂 سن" Variant="Variant.Outlined" Min="18" Max="80" Placeholder="مثلاً 30" Class="ltr-input" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_genderString" Label="👤 جنسیت" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Male")">مرد</MudSelectItem>
                            <MudSelectItem Value="@("Female")">زن</MudSelectItem>
                            <MudSelectItem Value="@("PreferNotToSay")">ترجیح نمی‌دهم</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_maritalStatusString" Label="💍 وضعیت تأهل" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Single")">مجرد</MudSelectItem>
                            <MudSelectItem Value="@("Married")">متأهل</MudSelectItem>
                            <MudSelectItem Value="@("Divorced")">مطلقه</MudSelectItem>
                            <MudSelectItem Value="@("Widowed")">همسر فوت شده</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                @if (factors.MaritalStatus == MaritalStatus.Married)
                {
                    <MudPaper Class="pa-4 mt-4" Elevation="0" Style="background: rgba(63,81,181,0.05); border-radius: 12px; border: 1px solid rgba(63,81,181,0.1);">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudNumericField T="int?" @bind-Value="factors.NumberOfChildren" Label="👶 تعداد فرزندان" Variant="Variant.Outlined" Min="0" Max="10" Class="ltr-input" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" @bind-Value="_spouseWorkingString" Label="💼 همسر شاغل است؟" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("true")">بله</MudSelectItem>
                                    <MudSelectItem Value="@("false")">خیر</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </div>

            @* ===== Step 2: Education & Language ===== *@
            <div class="@(currentStep == 1 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.School" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">تحصیلات و زبان</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">سطح تحصیلات و مهارت‌های زبانی</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_educationString" Label="📜 مقطع تحصیلی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("NoFormalEducation")">بدون تحصیلات</MudSelectItem>
                            <MudSelectItem Value="@("HighSchool")">دیپلم</MudSelectItem>
                            <MudSelectItem Value="@("AssociateDegree")">فوق دیپلم</MudSelectItem>
                            <MudSelectItem Value="@("BachelorDegree")">لیسانس</MudSelectItem>
                            <MudSelectItem Value="@("MasterDegree")">فوق لیسانس</MudSelectItem>
                            <MudSelectItem Value="@("PhD")">دکترا</MudSelectItem>
                            <MudSelectItem Value="@("PostDoctoral")">پسادکترا</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="factors.FieldOfStudy" Label="📚 رشته تحصیلی" Variant="Variant.Outlined" Placeholder="مثال: مهندسی کامپیوتر" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-6 mb-4">
                    <MudAvatar Color="Color.Info" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Translate" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle2" Class="text-grey">مهارت‌های زبانی</MudText>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_englishLevelString" Label="🇬🇧 انگلیسی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("None")">هیچ</MudSelectItem>
                            <MudSelectItem Value="@("Basic")">مقدماتی</MudSelectItem>
                            <MudSelectItem Value="@("Intermediate")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("Advanced")">پیشرفته</MudSelectItem>
                            <MudSelectItem Value="@("Native")">مادری</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_frenchLevelString" Label="🇫🇷 فرانسوی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("None")">هیچ</MudSelectItem>
                            <MudSelectItem Value="@("Basic")">مقدماتی</MudSelectItem>
                            <MudSelectItem Value="@("Intermediate")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("Advanced")">پیشرفته</MudSelectItem>
                            <MudSelectItem Value="@("Native")">مادری</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_germanLevelString" Label="🇩🇪 آلمانی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("None")">هیچ</MudSelectItem>
                            <MudSelectItem Value="@("Basic")">مقدماتی</MudSelectItem>
                            <MudSelectItem Value="@("Intermediate")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("Advanced")">پیشرفته</MudSelectItem>
                            <MudSelectItem Value="@("Native")">مادری</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </div>

            @* ===== Step 3: Work ===== *@
            <div class="@(currentStep == 2 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.Work" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">شغل و تخصص</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">وضعیت شغلی فعلی</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="factors.Occupation" Label="🏢 شغل فعلی" Variant="Variant.Outlined" Placeholder="مثال: مهندس نرم‌افزار" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int?" @bind-Value="factors.YearsOfExperience" Label="📅 سابقه کار (سال)" Variant="Variant.Outlined" Min="0" Max="50" Class="ltr-input" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_employmentString" Label="📋 نوع اشتغال" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Unemployed")">بیکار</MudSelectItem>
                            <MudSelectItem Value="@("PartTime")">پاره‌وقت</MudSelectItem>
                            <MudSelectItem Value="@("FullTime")">تمام‌وقت</MudSelectItem>
                            <MudSelectItem Value="@("SelfEmployed")">خوداشتغال</MudSelectItem>
                            <MudSelectItem Value="@("BusinessOwner")">صاحب کسب‌وکار</MudSelectItem>
                            <MudSelectItem Value="@("Retired")">بازنشسته</MudSelectItem>
                            <MudSelectItem Value="@("Student")">دانشجو</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal" @bind-Value="factors.AnnualIncomeUSD" Label="💵 درآمد سالانه (دلار)" Variant="Variant.Outlined" Min="0" Step="1000" Placeholder="مثلاً 25000" Class="ltr-input" />
                    </MudItem>
                </MudGrid>
            </div>

            @* ===== Step 4: Financial ===== *@
            <div class="@(currentStep == 3 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">وضعیت مالی</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">اطلاعات مالی برای پیشنهاد بهترین ویزا</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal" @bind-Value="factors.NetWorthUSD" Label="🏠 ارزش خالص دارایی‌ها (دلار)" Variant="Variant.Outlined" Min="0" Step="10000" Placeholder="مثلاً 200000" Class="ltr-input" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal" @bind-Value="factors.AnnualSavingsUSD" Label="🏦 پس‌انداز سالانه (دلار)" Variant="Variant.Outlined" Min="0" Step="5000" Placeholder="مثلاً 10000" Class="ltr-input" />
                    </MudItem>
                </MudGrid>
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool" @bind-Value="factors.HasInvestmentProperty" Label="🏗️ ملک سرمایه‌گذاری" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="text-grey">مالکیت ملک یا مستغلات</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool" @bind-Value="factors.HasBusinessOwnership" Label="🏪 کسب‌وکار" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="text-grey">مالکیت یا شراکت در کسب‌وکار</MudText>
                    </MudItem>
                </MudGrid>
            </div>

            @* ===== Step 5: Health ===== *@
            <div class="@(currentStep == 4 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">سلامت جسمی و روانی</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">وضعیت سلامت شما</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_physicalHealthString" Label="❤️ سلامت جسمی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Excellent")">عالی</MudSelectItem>
                            <MudSelectItem Value="@("Good")">خوب</MudSelectItem>
                            <MudSelectItem Value="@("Fair")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("Poor")">ضعیف</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_mentalHealthString" Label="🧠 سلامت روانی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Excellent")">عالی</MudSelectItem>
                            <MudSelectItem Value="@("Good")">خوب</MudSelectItem>
                            <MudSelectItem Value="@("Fair")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("NeedsSupport")">نیاز به حمایت</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_stressToleranceString" Label="⚡ تحمل استرس" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Low")">کم</MudSelectItem>
                            <MudSelectItem Value="@("Medium")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("High")">بالا</MudSelectItem>
                            <MudSelectItem Value="@("VeryHigh")">خیلی بالا</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_adaptabilityString" Label="🔄 انعطاف‌پذیری" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Low")">کم</MudSelectItem>
                            <MudSelectItem Value="@("Medium")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("High")">بالا</MudSelectItem>
                            <MudSelectItem Value="@("VeryHigh")">خیلی بالا</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool" @bind-Value="factors.HasChronicDisease" Label="🩺 بیماری مزمن" Color="Color.Warning" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCheckBox T="bool" @bind-Value="factors.NeedsSpecializedHealthcare" Label="🏥 نیاز به مراقبت ویژه" Color="Color.Warning" />
                    </MudItem>
                </MudGrid>
            </div>

            @* ===== Step 6: Social & Cultural ===== *@
            <div class="@(currentStep == 5 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">اجتماعی و فرهنگی</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">ترجیحات فرهنگی و اجتماعی</MudText>
                    </div>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_culturalPreferenceString" Label="🎭 ترجیح فرهنگی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Western")">غربی</MudSelectItem>
                            <MudSelectItem Value="@("Eastern")">شرقی</MudSelectItem>
                            <MudSelectItem Value="@("MiddleEastern")">خاورمیانه‌ای</MudSelectItem>
                            <MudSelectItem Value="@("Multicultural")">چندفرهنگی</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_religionPreferenceString" Label="🕌 ترجیح مذهبی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Muslim")">مسلمان</MudSelectItem>
                            <MudSelectItem Value="@("Christian")">مسیحی</MudSelectItem>
                            <MudSelectItem Value="@("Jewish")">یهودی</MudSelectItem>
                            <MudSelectItem Value="@("Other")">سایر</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                            <MudSelectItem Value="@("Secular")">سکولار</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_politicalStabilityString" Label="🏛️ اهمیت ثبات سیاسی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("NotImportant")">مهم نیست</MudSelectItem>
                            <MudSelectItem Value="@("SomewhatImportant")">تا حدی مهم</MudSelectItem>
                            <MudSelectItem Value="@("Important")">مهم</MudSelectItem>
                            <MudSelectItem Value="@("VeryImportant")">خیلی مهم</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_communityPreferenceString" Label="👥 ترجیح جامعه" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("LargeIranianCommunity")">جامعه بزرگ ایرانی</MudSelectItem>
                            <MudSelectItem Value="@("SmallIranianCommunity")">جامعه کوچک ایرانی</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                            <MudSelectItem Value="@("PreferDiverseCommunity")">ترجیح جامعه متنوع</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudPaper Class="pa-4 mt-4" Elevation="0" Style="background: rgba(63,81,181,0.05); border-radius: 12px; border: 1px solid rgba(63,81,181,0.1);">
                    <MudCheckBox T="bool" @bind-Value="factors.HasRelativesAbroad" Label="👨‍👩‍👧‍👦 خویشاوند در خارج دارم" Color="Color.Primary" />
                    @if (factors.HasRelativesAbroad)
                    {
                        <MudTextField @bind-Value="factors.RelativesCountries" Label="کشورهای محل اقامت خویشاوندان" Variant="Variant.Outlined" Class="mt-3" />
                    }
                </MudPaper>
            </div>

            @* ===== Step 7: Goals & Preferences ===== *@
            <div class="@(currentStep == 6 ? "" : "d-none")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="background: linear-gradient(135deg, #3f51b5, #673ab7);">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">اهداف و ترجیحات</MudText>
                        <MudText Typo="Typo.body2" Class="text-grey">اهداف مهاجرتی و ترجیحات جغرافیایی</MudText>
                    </div>
                </MudStack>
                <MudText Typo="Typo.subtitle2" Class="text-grey mb-3">اهداف اصلی (چند مورد)</MudText>
                <MudGrid Class="mb-6">
                    @{
                        var goals = new (string Value, string Label)[] {
                            ("BetterEconomicOpportunities", "💵 فرصت اقتصادی"), ("HigherQualityOfLife", "✨ کیفیت زندگی"),
                            ("Education", "🎓 تحصیل"), ("CareerGrowth", "📈 رشد شغلی"), ("FamilyReunification", "👨‍👩‍👧 پیوند خانواده"),
                            ("PoliticalStability", "🏛️ ثبات سیاسی"), ("Safety", "🛡️ امنیت"), ("Healthcare", "🏥 بهداشت"),
                            ("Retirement", "🌴 بازنشستگی"), ("BusinessExpansion", "🏪 توسعه کسب‌وکار"), ("CulturalExperience", "🎭 تجربه فرهنگی")
                        };
                    }
                    @foreach (var g in goals)
                    {
                        var goalEnum = (MigrationGoal)Enum.Parse(typeof(MigrationGoal), g.Value);
                        <MudItem xs="6" md="4">
                            <MudCheckBox T="bool" Value="@factors.Goals.Contains(goalEnum)" ValueChanged="@(v => ToggleGoal(goalEnum, v))" Label="@g.Label" Color="Color.Primary" Dense="true" />
                        </MudItem>
                    }
                </MudGrid>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_timelineString" Label="⏰ زمان‌بندی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Immediate")">فوری</MudSelectItem>
                            <MudSelectItem Value="@("Within3Months")">تا ۳ ماه</MudSelectItem>
                            <MudSelectItem Value="@("Within6Months")">تا ۶ ماه</MudSelectItem>
                            <MudSelectItem Value="@("Within1Year")">تا ۱ سال</MudSelectItem>
                            <MudSelectItem Value="@("Within2Years")">تا ۲ سال</MudSelectItem>
                            <MudSelectItem Value="@("Flexible")">انعطاف‌پذیر</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_climateString" Label="🌤️ آب‌وهوا" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Tropical")">گرمسیری</MudSelectItem>
                            <MudSelectItem Value="@("Temperate")">معتدل</MudSelectItem>
                            <MudSelectItem Value="@("Mediterranean")">مدیترانه‌ای</MudSelectItem>
                            <MudSelectItem Value="@("Continental")">قاره‌ای</MudSelectItem>
                            <MudSelectItem Value="@("Cold")">سرد</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_urbanRuralString" Label="🏙️ شهری/روستایی" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("BigCity")">شهر بزرگ</MudSelectItem>
                            <MudSelectItem Value="@("MediumCity")">شهر متوسط</MudSelectItem>
                            <MudSelectItem Value="@("SmallTown")">شهر کوچک</MudSelectItem>
                            <MudSelectItem Value="@("Rural")">روستا</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_distanceString" Label="📏 فاصله از ایران" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("VeryClose")">خیلی نزدیک</MudSelectItem>
                            <MudSelectItem Value="@("Close")">نزدیک</MudSelectItem>
                            <MudSelectItem Value="@("Moderate")">متوسط</MudSelectItem>
                            <MudSelectItem Value="@("Far")">دور</MudSelectItem>
                            <MudSelectItem Value="@("NoPreference")">بدون ترجیح</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudCheckBox T="bool" @bind-Value="factors.SeekingCitizenship" Label="🛂 به دنبال تابعیت هستم" Color="Color.Success" Class="mt-4" />
                @if (factors.NumberOfChildren > 0)
                {
                    <MudPaper Class="pa-4 mt-4" Elevation="0" Style="background: rgba(103,58,183,0.05); border-radius: 12px; border: 1px solid rgba(103,58,183,0.1);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3" Style="color: #673ab7;">👨‍👩‍👧‍👦 فرزندان و آموزش</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudCheckBox T="bool" @bind-Value="factors.ChildrenEducationImportant" Label="آموزش فرزندان مهم است" Color="Color.Secondary" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" @bind-Value="_eldestChildAgeString" Label="سن بزرگترین فرزند" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("Infant")">نوزاد (۰-۲)</MudSelectItem>
                                    <MudSelectItem Value="@("Child")">کودک (۳-۱۲)</MudSelectItem>
                                    <MudSelectItem Value="@("Teenager")">نوجوان (۱۳-۱۷)</MudSelectItem>
                                    <MudSelectItem Value="@("YoungAdult")">جوان (۱۸-۲۵)</MudSelectItem>
                                    <MudSelectItem Value="@("Adult")">بزرگسال</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </div>
        </MudPaper>
    </EditForm>
</MudContainer>

<!-- Bottom Navigation Bar -->
<div style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; background: white; border-top: 1px solid #e0e0e0; padding: 12px 16px; box-shadow: 0 -2px 8px rgba(0,0,0,0.1);">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mx-auto" Style="max-width: 960px;">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" OnClick="PrevStep" Disabled="@(currentStep == 0)" />
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="ClearForm" />
        @if (currentStep < 6)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="NextStep" Style="background: #3f51b5; color: white; border-radius: 50%;" />
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleSubmit" StartIcon="@Icons.Material.Filled.CheckCircle" Class="font-weight-bold">
                دریافت پیشنهادات مهاجرتی
            </MudButton>
        }
    </MudStack>
</div>

@code {
    private UserFactors factors = new();
    private int currentStep = 0;
    private int _activeStepIndex = 0;
    private string[] stepTitles = { "اطلاعات شخصی", "تحصیلات و زبان", "شغل و تخصص", "وضعیت مالی", "سلامت و روان", "اجتماعی و فرهنگی", "اهداف و ترجیحات" };

    // String-backed select bindings
    private string _genderString = "Male";
    private string _maritalStatusString = "Single";
    private string _spouseWorkingString = "false";
    private string _educationString = "BachelorDegree";
    private string _englishLevelString = "None";
    private string _frenchLevelString = "None";
    private string _germanLevelString = "None";
    private string _employmentString = "FullTime";
    private string _physicalHealthString = "Good";
    private string _mentalHealthString = "Good";
    private string _stressToleranceString = "Medium";
    private string _adaptabilityString = "Medium";
    private string _culturalPreferenceString = "NoPreference";
    private string _religionPreferenceString = "NoPreference";
    private string _politicalStabilityString = "Important";
    private string _communityPreferenceString = "NoPreference";
    private string _timelineString = "Within6Months";
    private string _climateString = "NoPreference";
    private string _urbanRuralString = "NoPreference";
    private string _distanceString = "NoPreference";
    private string _eldestChildAgeString = "Child";

    protected override void OnInitialized()
    {
        if (AppState.UserFactors.Age > 0)
        {
            factors = AppState.UserFactors;
            SyncStringsFromModel();
        }
    }

    private void SyncStringsFromModel()
    {
        _genderString = factors.Gender.ToString();
        _maritalStatusString = factors.MaritalStatus.ToString();
        _spouseWorkingString = factors.SpouseWorking.ToString().ToLower();
        _educationString = factors.Education.ToString();
        _englishLevelString = factors.EnglishLevel.ToString();
        _frenchLevelString = factors.FrenchLevel.ToString();
        _germanLevelString = factors.GermanLevel.ToString();
        _employmentString = factors.CurrentEmployment.ToString();
        _physicalHealthString = factors.PhysicalHealth.ToString();
        _mentalHealthString = factors.MentalHealth.ToString();
        _stressToleranceString = factors.StressTolerance.ToString();
        _adaptabilityString = factors.Adaptability.ToString();
        _culturalPreferenceString = factors.CulturalPreference.ToString();
        _religionPreferenceString = factors.ReligionPreference.ToString();
        _politicalStabilityString = factors.ImportanceOfPoliticalStability.ToString();
        _communityPreferenceString = factors.CommunityPreference.ToString();
        _timelineString = factors.PreferredTimeline.ToString();
        _climateString = factors.ClimatePreference.ToString();
        _urbanRuralString = factors.UrbanRuralPreference.ToString();
        _distanceString = factors.DistancePreference.ToString();
        _eldestChildAgeString = factors.EldestChildAge.ToString();
    }

    private void SyncModelFromStrings()
    {
        if (Enum.TryParse<Gender>(_genderString, out var g)) factors.Gender = g;
        if (Enum.TryParse<MaritalStatus>(_maritalStatusString, out var ms)) factors.MaritalStatus = ms;
        if (bool.TryParse(_spouseWorkingString, out var sw)) factors.SpouseWorking = sw;
        if (Enum.TryParse<EducationLevel>(_educationString, out var ed)) factors.Education = ed;
        if (Enum.TryParse<LanguageProficiency>(_englishLevelString, out var el)) factors.EnglishLevel = el;
        if (Enum.TryParse<LanguageProficiency>(_frenchLevelString, out var fl)) factors.FrenchLevel = fl;
        if (Enum.TryParse<LanguageProficiency>(_germanLevelString, out var gl)) factors.GermanLevel = gl;
        if (Enum.TryParse<EmploymentType>(_employmentString, out var es)) factors.CurrentEmployment = es;
        if (Enum.TryParse<PhysicalHealthStatus>(_physicalHealthString, out var ph)) factors.PhysicalHealth = ph;
        if (Enum.TryParse<MentalHealthStatus>(_mentalHealthString, out var mh)) factors.MentalHealth = mh;
        if (Enum.TryParse<StressToleranceLevel>(_stressToleranceString, out var st)) factors.StressTolerance = st;
        if (Enum.TryParse<AdaptabilityLevel>(_adaptabilityString, out var ad)) factors.Adaptability = ad;
        if (Enum.TryParse<CulturalPreference>(_culturalPreferenceString, out var cp)) factors.CulturalPreference = cp;
        if (Enum.TryParse<ReligionPreference>(_religionPreferenceString, out var rp)) factors.ReligionPreference = rp;
        if (Enum.TryParse<ImportanceOfPoliticalStability>(_politicalStabilityString, out var ps)) factors.ImportanceOfPoliticalStability = ps;
        if (Enum.TryParse<CommunityIntegrationPreference>(_communityPreferenceString, out var cpr)) factors.CommunityPreference = cpr;
        if (Enum.TryParse<MigrationTimeline>(_timelineString, out var tl)) factors.PreferredTimeline = tl;
        if (Enum.TryParse<ClimatePreference>(_climateString, out var cl)) factors.ClimatePreference = cl;
        if (Enum.TryParse<UrbanRuralPreference>(_urbanRuralString, out var ur)) factors.UrbanRuralPreference = ur;
        if (Enum.TryParse<DistanceFromIranPreference>(_distanceString, out var dp)) factors.DistancePreference = dp;
        if (Enum.TryParse<AgeGroup>(_eldestChildAgeString, out var ca)) factors.EldestChildAge = ca;
    }

    private void GoToStep(int step)
    {
        if (step <= currentStep)
        {
            currentStep = step;
            _activeStepIndex = step;
        }
    }

    private void NextStep()
    {
        if (currentStep < 6)
        {
            currentStep++;
            _activeStepIndex = currentStep;
        }
    }

    private void PrevStep()
    {
        if (currentStep > 0)
        {
            currentStep--;
            _activeStepIndex = currentStep;
        }
    }

    private void ClearForm()
    {
        factors = new UserFactors();
        currentStep = 0;
        _activeStepIndex = 0;
        SyncStringsFromModel();
    }

    private void OnMaritalStatusStringChanged(string value)
    {
        _maritalStatusString = value;
        if (Enum.TryParse<MaritalStatus>(value, out var ms))
        {
            factors.MaritalStatus = ms;
        }
        StateHasChanged();
    }

    private void ToggleGoal(MigrationGoal goal, bool isChecked)
    {
        if (isChecked && !factors.Goals.Contains(goal))
        {
            factors.Goals.Add(goal);
        }
        else if (!isChecked && factors.Goals.Contains(goal))
        {
            factors.Goals.Remove(goal);
        }
    }

    private void HandleSubmit()
    {
        SyncModelFromStrings();
        AppState.UserFactors = factors;
        AppState.Results = AdvisorService.GetRecommendations(factors);
        NavigationManager.NavigateTo("/results");
    }
}
