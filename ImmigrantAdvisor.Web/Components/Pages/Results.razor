@page "/results"
@using ImmigrantAdvisor.Shared.Models
@using ImmigrantAdvisor.Shared.Services
@using ImmigrantAdvisor.Web.Components.Shared
@inject NavigationManager NavigationManager
@inject AppStateService AppState

<PageTitle>نتایج مشاوره مهاجرت</PageTitle>

<MudAppBar Color="Color.Primary" Elevation="3">
    <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Class="ml-3" />
    <MudText Typo="Typo.h6" Class="ml-3">نتایج مشاوره مهاجرت</MudText>
    <MudSpacer />
    <MudText Typo="Typo.caption" Class="text-white">بر اساس اطلاعات شما</MudText>
</MudAppBar>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    @if (results == null || !results.Any())
    {
        <MudCard Elevation="3" Class="text-center pa-12">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" Class="mb-4" Style="font-size: 4rem;" />
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">هیچ نتیجه‌ای یافت نشد</MudText>
            <MudText Typo="Typo.body1" Class="text-grey mb-6">لطفاً اطلاعات خود را بازبینی کنید و دوباره تلاش کنید.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.ArrowBack" Class="font-weight-bold">
                بازگشت به فرم
            </MudButton>
        </MudCard>
    }
    else
    {
        <!-- Results Summary -->
        <MudCard Elevation="3" Class="mb-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Success" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@results.Count کشور مناسب شما پیدا شد</MudText>
                        <MudText Typo="Typo.caption" Class="text-grey">مرتب‌شده بر اساس بیشترین تطابق</MudText>
                    </div>
                </MudStack>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/" EndIcon="@Icons.Material.Filled.Edit">
                    ویرایش اطلاعات
                </MudButton>
            </MudStack>
        </MudCard>

        <!-- Country Cards -->
        <MudStack Spacing="6">
            @for (int idx = 0; idx < results.Count; idx++)
            {
                var plan = results[idx];
                <MudCard Elevation="3" Style="border-radius: 16px; overflow: hidden;">
                    <!-- Country Header -->
                    <MudCardHeader Style="background: linear-gradient(135deg, #3f51b5, #673ab7); color: white; padding: 20px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudText Typo="Typo.h3">@plan.Country.FlagEmoji</MudText>
                                <div>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@plan.Country.NamePersian</MudText>
                                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">@plan.Country.Name</MudText>
                                </div>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                @if (idx == 0)
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.EmojiEvents" Class="font-weight-bold">
                                        🏆 بهترین گزینه
                                    </MudChip>
                                }
                                <MudPaper Class="pa-3 text-center" Elevation="0" Style="background: rgba(255,255,255,0.2); border-radius: 12px;">
                                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7);">امتیاز تطابق</MudText>
                                    <MudText Typo="Typo.h4" Class="font-weight-bold">
                                        @plan.MatchScore<span style="font-size: 0.7em; color: rgba(255,255,255,0.7);">/100</span>
                                    </MudText>
                                </MudPaper>
                            </MudStack>
                        </MudStack>
                    </MudCardHeader>

                    <MudCardContent Class="pa-6">
                        <!-- Score Bars -->
                        <MudGrid Class="mb-6">
                            <MudItem xs="6" md="3">
                                <ScoreCard Label="کیفیت زندگی" Score="@plan.Country.QualityOfLifeScore" Color="green" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <ScoreCard Label="امنیت" Score="@plan.Country.SafetyScore" Color="blue" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <ScoreCard Label="بهداشت" Score="@plan.Country.HealthcareScore" Color="yellow" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <ScoreCard Label="آموزش" Score="@plan.Country.EducationScore" Color="purple" />
                            </MudItem>
                        </MudGrid>

                        <!-- Key Info -->
                        <MudGrid Class="mb-6">
                            <MudItem xs="6" md="3">
                                <InfoCard Icon="🌍" Label="قاره" Value="@plan.Country.Continent" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <InfoCard Icon="📏" Label="فاصله" Value="@($"{plan.Country.DistanceFromIranKm:N0} km")" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <InfoCard Icon="👥" Label="جمعیت ایرانی" Value="@plan.Country.IranianPopulation.ToString("N0")" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <InfoCard Icon="🛂" Label="تابعیت" Value="@($"{plan.Country.CitizenshipYears} سال")" />
                            </MudItem>
                        </MudGrid>

                        <!-- Visa Info -->
                        <MudPaper Class="pa-5 mb-6" Elevation="0" Style="background: linear-gradient(135deg, rgba(0,188,212,0.05), rgba(33,150,243,0.05)); border: 1px solid rgba(0,188,212,0.2); border-radius: 12px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Color="Color.Info" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #01579b;">ویزای پیشنهادی: @plan.RecommendedVisa.Name</MudText>
                            </MudStack>
                            <MudGrid>
                                <MudItem xs="6" md="4">
                                    <MudText Typo="Typo.body2"><span class="text-grey">نوع:</span> <strong>@plan.RecommendedVisa.Type</strong></MudText>
                                </MudItem>
                                <MudItem xs="6" md="4">
                                    <MudText Typo="Typo.body2"><span class="text-grey">مدت:</span> <strong>@plan.RecommendedVisa.Duration</strong></MudText>
                                </MudItem>
                                <MudItem xs="6" md="4">
                                    <MudText Typo="Typo.body2"><span class="text-grey">پردازش:</span> <strong>@plan.RecommendedVisa.ProcessingTimeMonths ماه</strong></MudText>
                                </MudItem>
                                <MudItem xs="6" md="4">
                                    <MudText Typo="Typo.body2">
                                        <span class="text-grey">اقامت دائم:</span>
                                        <strong class="@(plan.RecommendedVisa.LeadsToPR ? "mud-theme-success" : "text-grey")">
                                            @(plan.RecommendedVisa.LeadsToPR ? "✓ بله" : "خیر")
                                        </strong>
                                    </MudText>
                                </MudItem>
                                <MudItem xs="6" md="4">
                                    <MudText Typo="Typo.body2">
                                        <span class="text-grey">تابعیت:</span>
                                        <strong class="@(plan.RecommendedVisa.LeadsToCitizenship ? "mud-theme-success" : "text-grey")">
                                            @(plan.RecommendedVisa.LeadsToCitizenship ? "✓ بله" : "خیر")
                                        </strong>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Financial -->
                        <MudGrid Class="mb-6">
                            <MudItem xs="6">
                                <MudPaper Class="pa-4 text-center" Elevation="0" Style="background: rgba(244,67,54,0.05); border: 1px solid rgba(244,67,54,0.1); border-radius: 12px;">
                                    <MudText Typo="Typo.caption" Style="color: #d32f2f;">هزینه ماهانه تخمینی</MudText>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #d32f2f;">$@plan.EstimatedMonthlyCostUSD.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="pa-4 text-center" Elevation="0" Style="background: rgba(76,175,80,0.05); border: 1px solid rgba(76,175,80,0.1); border-radius: 12px;">
                                    <MudText Typo="Typo.caption" Style="color: #388e3c;">درآمد ماهانه متوسط</MudText>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #388e3c;">$@plan.EstimatedMonthlyIncomeUSD.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <!-- Strengths & Challenges -->
                        <MudGrid Class="mb-6">
                            @if (plan.Strengths.Any())
                            {
                                <MudItem xs="12" md="6">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Color="Color.Success" Size="Size.Small">
                                                <MudIcon Icon="@Icons.Material.Filled.Check" />
                                            </MudAvatar>
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #388e3c;">نقاط قوت</MudText>
                                        </MudStack>
                                        @foreach (var s in plan.Strengths)
                                        {
                                            <MudPaper Class="pa-3" Elevation="0" Style="background: rgba(76,175,80,0.05); border: 1px solid rgba(76,175,80,0.1); border-radius: 8px;">
                                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color: #4caf50; font-size: 8px; margin-top: 6px;" />
                                                    <MudText Typo="Typo.body2" Style="color: #2e7d32;">@s</MudText>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                </MudItem>
                            }
                            @if (plan.Challenges.Any())
                            {
                                <MudItem xs="12" md="6">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Color="Color.Warning" Size="Size.Small">
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" />
                                            </MudAvatar>
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #f57c00;">چالش‌ها</MudText>
                                        </MudStack>
                                        @foreach (var c in plan.Challenges)
                                        {
                                            <MudPaper Class="pa-3" Elevation="0" Style="background: rgba(255,152,0,0.05); border: 1px solid rgba(255,152,0,0.1); border-radius: 8px;">
                                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color: #ff9800; font-size: 8px; margin-top: 6px;" />
                                                    <MudText Typo="Typo.body2" Style="color: #e65100;">@c</MudText>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>

                        <!-- Recommendations -->
                        @if (plan.Recommendations.Any())
                        {
                            <MudStack Spacing="2" Class="mb-6">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Info" Size="Size.Small">
                                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb" />
                                    </MudAvatar>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #0288d1;">توصیه‌ها</MudText>
                                </MudStack>
                                @foreach (var r in plan.Recommendations)
                                {
                                    <MudPaper Class="pa-3" Elevation="0" Style="background: rgba(33,150,243,0.05); border: 1px solid rgba(33,150,243,0.1); border-radius: 8px;">
                                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: #2196f3; margin-top: 2px;" />
                                            <MudText Typo="Typo.body2" Style="color: #01579b;">@r</MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }

                        <!-- Steps -->
                        @if (plan.Steps.Any())
                        {
                            <MudStack Spacing="2" Class="mb-6">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                                        <MudIcon Icon="@Icons.Material.Filled.List" />
                                    </MudAvatar>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #3f51b5;">مراحل اقدام</MudText>
                                </MudStack>
                                @for (int i = 0; i < plan.Steps.Count; i++)
                                {
                                    var step = plan.Steps[i];
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                        <MudAvatar Color="Color.Primary" Size="Size.Small" Style="min-width: 28px; min-height: 28px; font-size: 0.75rem;">
                                            @(i + 1)
                                        </MudAvatar>
                                        <MudText Typo="Typo.body2" Class="text-grey" Style="padding-top: 2px;">@step</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        <!-- Expandable Sections -->
                        <MudStack Spacing="3">
                            @if (plan.RecommendedVisa.Requirements.Any())
                            {
                                <MudExpansionPanels>
                                    <MudExpansionPanel Text="نیازمندی‌های ویزا">
                                        <MudStack Spacing="1">
                                            @foreach (var req in plan.RecommendedVisa.Requirements)
                                            {
                                                <MudPaper Class="pa-3" Elevation="0" Style="background: rgba(63,81,181,0.02); border: 1px solid rgba(63,81,181,0.1); border-radius: 8px;">
                                                    <MudText Typo="Typo.body2" Class="text-grey">• @req</MudText>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                            @if (plan.RecommendedVisa.Benefits.Any())
                            {
                                <MudExpansionPanels>
                                    <MudExpansionPanel Text="مزایای ویزا">
                                        <MudStack Spacing="1">
                                            @foreach (var b in plan.RecommendedVisa.Benefits)
                                            {
                                                <MudPaper Class="pa-3" Elevation="0" Style="background: rgba(76,175,80,0.02); border: 1px solid rgba(76,175,80,0.1); border-radius: 8px;">
                                                    <MudText Typo="Typo.body2" Style="color: #2e7d32;">✓ @b</MudText>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>

        <!-- Bottom Action -->
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Large" Class="font-weight-bold" Style="border-width: 2px;">
                بازگشت و ویرایش اطلاعات
            </MudButton>
        </MudStack>
    }
</MudContainer>

@code {
    private List<MigrationPlan> results = new();

    protected override void OnInitialized()
    {
        results = AppState.Results ?? new();
        if (!results.Any())
        {
            NavigationManager.NavigateTo("/");
        }
    }
}
