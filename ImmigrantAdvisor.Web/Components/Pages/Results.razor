@page "/results"
@using ImmigrantAdvisor.Web.Models
@using ImmigrantAdvisor.Web.Services
@inject ImmigrationAdvisorService AdvisorService
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>نتایج مشاوره مهاجرت</PageTitle>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0">📊 نتایج مشاوره مهاجرت</h2>
                    <p class="mb-0 mt-2">بر اساس اطلاعات شما، این گزینه‌ها پیشنهاد می‌شوند</p>
                </div>
                <div class="card-body">
                    @if (results == null || !results.Any())
                    {
                        <div class="alert alert-warning text-center">
                            <h4>⚠️ هیچ نتیجه‌ای یافت نشد</h4>
                            <p>لطفاً اطلاعات خود را بازبینی کنید و دوباره تلاش کنید.</p>
                            <a href="/" class="btn btn-primary">بازگشت به فرم</a>
                        </div>
                    }
                    else
                    {
                        <div class="results-container">
                            @foreach (var plan in results)
                            {
                                <div class="result-card mb-4">
                                    <div class="card border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h3 class="mb-0">
                                                    @plan.Country.FlagEmoji @plan.Country.NamePersian (@plan.Country.Name)
                                                </h3>
                                                <div class="score-badge">
                                                    <span class="badge bg-light text-dark fs-5">
                                                        امتیاز تطابق: @plan.MatchScore
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <!-- اطلاعات کشور -->
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <h5 class="text-primary">📍 اطلاعات کلی</h5>
                                                    <ul class="list-unstyled">
                                                        <li><strong>قاره:</strong> @plan.Country.Continent</li>
                                                        <li><strong>فاصله از ایران:</strong> @plan.Country.DistanceFromIranKm کیلومتر</li>
                                                        <li><strong>جمعیت ایرانی:</strong> @plan.Country.IranianPopulation.ToString("N0") نفر</li>
                                                        <li><strong>زبان‌های رسمی:</strong> @string.Join("، ", plan.Country.OfficialLanguages)</li>
                                                        <li><strong>تابعیت:</strong> پس از @plan.Country.CitizenshipYears سال</li>
                                                    </ul>
                                                </div>
                                                <div class="col-md-6">
                                                    <h5 class="text-primary">📈 امتیازات کشور</h5>
                                                    <div class="progress mb-2" style="height: 25px;">
                                                        <div class="progress-bar bg-success" role="progressbar" 
                                                             style="width: @plan.Country.QualityOfLifeScore%">
                                                            کیفیت زندگی: @plan.Country.QualityOfLifeScore
                                                        </div>
                                                    </div>
                                                    <div class="progress mb-2" style="height: 25px;">
                                                        <div class="progress-bar bg-info" role="progressbar" 
                                                             style="width: @plan.Country.SafetyScore%">
                                                            امنیت: @plan.Country.SafetyScore
                                                        </div>
                                                    </div>
                                                    <div class="progress mb-2" style="height: 25px;">
                                                        <div class="progress-bar bg-warning" role="progressbar" 
                                                             style="width: @plan.Country.HealthcareScore%">
                                                            بهداشت: @plan.Country.HealthcareScore
                                                        </div>
                                                    </div>
                                                    <div class="progress mb-2" style="height: 25px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" 
                                                             style="width: @plan.Country.EducationScore%">
                                                            آموزش: @plan.Country.EducationScore
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ویزای پیشنهادی -->
                                            <div class="alert alert-info">
                                                <h5 class="text-primary">🎫 ویزای پیشنهادی</h5>
                                                <h6 class="fw-bold">@plan.RecommendedVisa.Name</h6>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>نوع:</strong> @plan.RecommendedVisa.Type</p>
                                                        <p><strong>مدت:</strong> @plan.RecommendedVisa.Duration</p>
                                                        <p><strong>زمان پردازش:</strong> @plan.RecommendedVisa.ProcessingTimeMonths ماه</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <p><strong>منجر به اقامت دائم:</strong> @(plan.RecommendedVisa.LeadsToPR ? "بله ✓" : "خیر")</p>
                                                        <p><strong>منجر به تابعیت:</strong> @(plan.RecommendedVisa.LeadsToCitizenship ? "بله ✓" : "خیر")</p>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- هزینه‌ها و درآمد -->
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <div class="card bg-light">
                                                        <div class="card-body text-center">
                                                            <h6 class="text-muted">هزینه ماهانه تخمینی</h6>
                                                            <h3 class="text-danger">$@plan.EstimatedMonthlyCostUSD.ToString("N0")</h3>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="card bg-light">
                                                        <div class="card-body text-center">
                                                            <h6 class="text-muted">درآمد ماهانه متوسط</h6>
                                                            <h3 class="text-success">$@plan.EstimatedMonthlyIncomeUSD.ToString("N0")</h3>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- نقاط قوت -->
                                            @if (plan.Strengths.Any())
                                            {
                                                <div class="mb-3">
                                                    <h5 class="text-success">✓ نقاط قوت</h5>
                                                    <div class="row">
                                                        @foreach (var strength in plan.Strengths)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="alert alert-success mb-2 py-2">
                                                                    @strength
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- چالش‌ها -->
                                            @if (plan.Challenges.Any())
                                            {
                                                <div class="mb-3">
                                                    <h5 class="text-warning">⚠ چالش‌ها</h5>
                                                    <div class="row">
                                                        @foreach (var challenge in plan.Challenges)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="alert alert-warning mb-2 py-2">
                                                                    @challenge
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- توصیه‌ها -->
                                            @if (plan.Recommendations.Any())
                                            {
                                                <div class="mb-3">
                                                    <h5 class="text-info">💡 توصیه‌ها</h5>
                                                    <ul class="list-group">
                                                        @foreach (var rec in plan.Recommendations)
                                                        {
                                                            <li class="list-group-item list-group-item-info">@rec</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            <!-- مراحل -->
                                            @if (plan.Steps.Any())
                                            {
                                                <div class="mb-3">
                                                    <h5 class="text-primary">📋 مراحل اقدام</h5>
                                                    <ol class="list-group list-group-numbered">
                                                        @foreach (var step in plan.Steps)
                                                        {
                                                            <li class="list-group-item">@step</li>
                                                        }
                                                    </ol>
                                                </div>
                                            }

                                            <!-- نیازمندی‌های ویزا -->
                                            @if (plan.RecommendedVisa.Requirements.Any())
                                            {
                                                <details class="mb-3">
                                                    <summary class="btn btn-outline-primary">
                                                        📄 مشاهده نیازمندی‌های ویزا
                                                    </summary>
                                                    <div class="mt-2">
                                                        <ul class="list-group">
                                                            @foreach (var req in plan.RecommendedVisa.Requirements)
                                                            {
                                                                <li class="list-group-item">@req</li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </details>
                                            }

                                            <!-- مزایای ویزا -->
                                            @if (plan.RecommendedVisa.Benefits.Any())
                                            {
                                                <details class="mb-3">
                                                    <summary class="btn btn-outline-success">
                                                        🎁 مشاهده مزایای ویزا
                                                    </summary>
                                                    <div class="mt-2">
                                                        <ul class="list-group">
                                                            @foreach (var benefit in plan.RecommendedVisa.Benefits)
                                                            {
                                                                <li class="list-group-item list-group-item-success">@benefit</li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <a href="/" class="btn btn-secondary btn-lg">
                                🔄 بازگشت و ویرایش اطلاعات
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MigrationPlan> results = new();

    protected override void OnInitialized()
    {
        // Load results from AppState
        results = AppState.Results;
        
        // If no results, redirect to home
        if (results == null || !results.Any())
        {
            NavigationManager.NavigateTo("/");
        }
    }
}
