@page "/"
@using ImmigrantAdvisor.Shared.Models
@using ImmigrantAdvisor.Shared.Services
@inject ImmigrationAdvisorService AdvisorService
@inject AppStateService AppState
@inject NavigationManager NavigationManager

<PageTitle>مشاور مهاجرت هوشمند</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100">
    <!-- Header -->
    <div class="bg-gradient-to-l from-blue-600 via-indigo-600 to-violet-700 text-white">
        <div class="max-w-4xl mx-auto px-4 py-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl mb-4">
                <span class="text-3xl">🌍</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-bold mb-2">مشاور مهاجرت هوشمند</h1>
            <p class="text-blue-100 text-sm md:text-base">اطلاعات خود را وارد کنید تا بهترین گزینه‌های مهاجرتی را پیشنهاد دهیم</p>
        </div>
    </div>

    <!-- Stepper -->
    <div class="max-w-4xl mx-auto px-4 -mt-6">
        <div class="bg-white rounded-2xl shadow-lg p-4 md:p-6">
            <div class="flex items-center justify-between">
                @for (int i = 0; i < TotalSteps; i++)
                {
                    var stepIndex = i;
                    <div class="flex items-center @(stepIndex < TotalSteps - 1 ? "flex-1" : "")">
                        <button @onclick="() => GoToStep(stepIndex)"
                                class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-full text-sm font-bold transition-all duration-300 shrink-0
                                    @(currentStep == stepIndex ? "bg-indigo-600 text-white shadow-lg shadow-indigo-200 scale-110" :
                                      stepIndex < currentStep ? "bg-green-500 text-white" :
                                      "bg-gray-100 text-gray-400")">
                            @if (stepIndex < currentStep)
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                @(stepIndex + 1)
                            }
                        </button>
                        @if (stepIndex < TotalSteps - 1)
                        {
                            <div class="flex-1 mx-1 md:mx-2 h-1 rounded-full overflow-hidden bg-gray-100">
                                <div class="h-full rounded-full transition-all duration-500 @(stepIndex < currentStep ? "bg-green-500 w-full" : "bg-gray-100 w-0")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mt-3 text-center">
                <span class="text-sm font-medium text-indigo-600">@StepTitles[currentStep]</span>
                <span class="text-xs text-gray-400 mr-2">مرحله @(currentStep + 1) از @TotalSteps</span>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div class="max-w-4xl mx-auto px-4 py-6">
        <EditForm Model="@factors" OnValidSubmit="@HandleSubmit" FormName="ImmigrationForm">
            <DataAnnotationsValidator />
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="p-6 md:p-8">

                    @* ===== Step 1: Personal Info ===== *@
                    @if (currentStep == 0)
                    {
                        <StepSection Icon="👤" Title="اطلاعات شخصی" Subtitle="اطلاعات پایه خود را وارد کنید">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                                <FormField Label="سن" Icon="🎂">
                                    <InputNumber @bind-Value="factors.Age" class="wizard-input" min="18" max="80" placeholder="مثلاً ۳۰" />
                                </FormField>
                                <FormField Label="جنسیت" Icon="👤">
                                    <InputSelect @bind-Value="factors.Gender" class="wizard-input">
                                        <option value="@Gender.Male">مرد</option>
                                        <option value="@Gender.Female">زن</option>
                                        <option value="@Gender.PreferNotToSay">ترجیح می‌دهم نگویم</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="وضعیت تأهل" Icon="💍">
                                    <InputSelect @bind-Value="factors.MaritalStatus" class="wizard-input">
                                        <option value="@MaritalStatus.Single">مجرد</option>
                                        <option value="@MaritalStatus.Married">متأهل</option>
                                        <option value="@MaritalStatus.Divorced">مطلقه</option>
                                        <option value="@MaritalStatus.Widowed">همسر فوت شده</option>
                                    </InputSelect>
                                </FormField>
                            </div>
                            @if (factors.MaritalStatus == MaritalStatus.Married)
                            {
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100">
                                    <FormField Label="تعداد فرزندان" Icon="👶">
                                        <InputNumber @bind-Value="factors.NumberOfChildren" class="wizard-input" min="0" max="10" />
                                    </FormField>
                                    <FormField Label="همسر شاغل است؟" Icon="💼">
                                        <InputSelect @bind-Value="factors.SpouseWorking" class="wizard-input">
                                            <option value="true">بله</option>
                                            <option value="false">خیر</option>
                                        </InputSelect>
                                    </FormField>
                                </div>
                            }
                        </StepSection>
                    }

                    @* ===== Step 2: Education & Language ===== *@
                    @if (currentStep == 1)
                    {
                        <StepSection Icon="🎓" Title="تحصیلات و زبان" Subtitle="سطح تحصیلات و مهارت‌های زبانی خود را مشخص کنید">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="مقطع تحصیلی" Icon="📜">
                                    <InputSelect @bind-Value="factors.Education" class="wizard-input">
                                        <option value="@EducationLevel.NoFormalEducation">بدون تحصیلات رسمی</option>
                                        <option value="@EducationLevel.HighSchool">دیپلم</option>
                                        <option value="@EducationLevel.AssociateDegree">فوق دیپلم</option>
                                        <option value="@EducationLevel.BachelorDegree">لیسانس</option>
                                        <option value="@EducationLevel.MasterDegree">فوق لیسانس</option>
                                        <option value="@EducationLevel.PhD">دکترا</option>
                                        <option value="@EducationLevel.PostDoctoral">پسادکترا</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="رشته تحصیلی" Icon="📚">
                                    <InputText @bind-Value="factors.FieldOfStudy" class="wizard-input" placeholder="مثال: مهندسی کامپیوتر" />
                                </FormField>
                            </div>
                            <div class="mt-6">
                                <h4 class="text-sm font-semibold text-gray-500 mb-4 flex items-center gap-2">
                                    <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-base">🗣</span>
                                    مهارت‌های زبانی
                                </h4>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                                    <FormField Label="انگلیسی" Icon="🇬🇧">
                                        <InputSelect @bind-Value="factors.EnglishLevel" class="wizard-input">
                                            <option value="@LanguageProficiency.None">هیچ</option>
                                            <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                            <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                            <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                            <option value="@LanguageProficiency.Native">مادری</option>
                                        </InputSelect>
                                    </FormField>
                                    <FormField Label="فرانسوی" Icon="🇫🇷">
                                        <InputSelect @bind-Value="factors.FrenchLevel" class="wizard-input">
                                            <option value="@LanguageProficiency.None">هیچ</option>
                                            <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                            <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                            <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                            <option value="@LanguageProficiency.Native">مادری</option>
                                        </InputSelect>
                                    </FormField>
                                    <FormField Label="آلمانی" Icon="🇩🇪">
                                        <InputSelect @bind-Value="factors.GermanLevel" class="wizard-input">
                                            <option value="@LanguageProficiency.None">هیچ</option>
                                            <option value="@LanguageProficiency.Basic">مقدماتی</option>
                                            <option value="@LanguageProficiency.Intermediate">متوسط</option>
                                            <option value="@LanguageProficiency.Advanced">پیشرفته</option>
                                            <option value="@LanguageProficiency.Native">مادری</option>
                                        </InputSelect>
                                    </FormField>
                                </div>
                            </div>
                        </StepSection>
                    }

                    @* ===== Step 3: Work & Experience ===== *@
                    @if (currentStep == 2)
                    {
                        <StepSection Icon="💼" Title="شغل و تخصص" Subtitle="وضعیت شغلی فعلی خود را وارد کنید">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="شغل فعلی" Icon="🏢">
                                    <InputText @bind-Value="factors.Occupation" class="wizard-input" placeholder="مثال: مهندس نرم‌افزار" />
                                </FormField>
                                <FormField Label="سابقه کار (سال)" Icon="📅">
                                    <InputNumber @bind-Value="factors.YearsOfExperience" class="wizard-input" min="0" max="50" />
                                </FormField>
                                <FormField Label="نوع اشتغال" Icon="📋">
                                    <InputSelect @bind-Value="factors.CurrentEmployment" class="wizard-input">
                                        <option value="@EmploymentType.Unemployed">بیکار</option>
                                        <option value="@EmploymentType.PartTime">پاره‌وقت</option>
                                        <option value="@EmploymentType.FullTime">تمام‌وقت</option>
                                        <option value="@EmploymentType.SelfEmployed">خوداشتغال</option>
                                        <option value="@EmploymentType.BusinessOwner">صاحب کسب‌وکار</option>
                                        <option value="@EmploymentType.Retired">بازنشسته</option>
                                        <option value="@EmploymentType.Student">دانشجو</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="درآمد سالانه (دلار)" Icon="💵">
                                    <InputNumber @bind-Value="factors.AnnualIncomeUSD" class="wizard-input" min="0" step="1000" placeholder="مثلاً 25000" />
                                </FormField>
                            </div>
                        </StepSection>
                    }

                    @* ===== Step 4: Financial ===== *@
                    @if (currentStep == 3)
                    {
                        <StepSection Icon="💰" Title="وضعیت مالی" Subtitle="اطلاعات مالی شما برای پیشنهاد بهترین ویزا">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="ارزش خالص دارایی‌ها (دلار)" Icon="🏠">
                                    <InputNumber @bind-Value="factors.NetWorthUSD" class="wizard-input" min="0" step="10000" placeholder="مثلاً 200000" />
                                </FormField>
                                <FormField Label="پس‌انداز سالانه (دلار)" Icon="🏦">
                                    <InputNumber @bind-Value="factors.AnnualSavingsUSD" class="wizard-input" min="0" step="5000" placeholder="مثلاً 10000" />
                                </FormField>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
                                <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all
                                    @(factors.HasInvestmentProperty ? "border-indigo-500 bg-indigo-50" : "border-gray-200 hover:border-gray-300")">
                                    <InputCheckbox @bind-Value="factors.HasInvestmentProperty" class="w-5 h-5 text-indigo-600 rounded" />
                                    <div>
                                        <span class="font-medium text-gray-700">🏗️ ملک سرمایه‌گذاری</span>
                                        <p class="text-xs text-gray-400 mt-0.5">مالکیت ملک یا مستغلات سرمایه‌گذاری</p>
                                    </div>
                                </label>
                                <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all
                                    @(factors.HasBusinessOwnership ? "border-indigo-500 bg-indigo-50" : "border-gray-200 hover:border-gray-300")">
                                    <InputCheckbox @bind-Value="factors.HasBusinessOwnership" class="w-5 h-5 text-indigo-600 rounded" />
                                    <div>
                                        <span class="font-medium text-gray-700">🏪 کسب‌وکار</span>
                                        <p class="text-xs text-gray-400 mt-0.5">مالکیت یا شراکت در کسب‌وکار</p>
                                    </div>
                                </label>
                            </div>
                        </StepSection>
                    }

                    @* ===== Step 5: Health ===== *@
                    @if (currentStep == 4)
                    {
                        <StepSection Icon="🏥" Title="سلامت جسمی و روانی" Subtitle="وضعیت سلامت شما در انتخاب مقصد تأثیر دارد">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="سلامت جسمی" Icon="❤️">
                                    <InputSelect @bind-Value="factors.PhysicalHealth" class="wizard-input">
                                        <option value="@PhysicalHealthStatus.Excellent">عالی</option>
                                        <option value="@PhysicalHealthStatus.Good">خوب</option>
                                        <option value="@PhysicalHealthStatus.Fair">متوسط</option>
                                        <option value="@PhysicalHealthStatus.Poor">ضعیف</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="سلامت روانی" Icon="🧠">
                                    <InputSelect @bind-Value="factors.MentalHealth" class="wizard-input">
                                        <option value="@MentalHealthStatus.Excellent">عالی</option>
                                        <option value="@MentalHealthStatus.Good">خوب</option>
                                        <option value="@MentalHealthStatus.Fair">متوسط</option>
                                        <option value="@MentalHealthStatus.NeedsSupport">نیاز به حمایت</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="تحمل استرس" Icon="⚡">
                                    <InputSelect @bind-Value="factors.StressTolerance" class="wizard-input">
                                        <option value="@StressToleranceLevel.Low">کم</option>
                                        <option value="@StressToleranceLevel.Medium">متوسط</option>
                                        <option value="@StressToleranceLevel.High">بالا</option>
                                        <option value="@StressToleranceLevel.VeryHigh">خیلی بالا</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="انعطاف‌پذیری" Icon="🔄">
                                    <InputSelect @bind-Value="factors.Adaptability" class="wizard-input">
                                        <option value="@AdaptabilityLevel.Low">کم</option>
                                        <option value="@AdaptabilityLevel.Medium">متوسط</option>
                                        <option value="@AdaptabilityLevel.High">بالا</option>
                                        <option value="@AdaptabilityLevel.VeryHigh">خیلی بالا</option>
                                    </InputSelect>
                                </FormField>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
                                <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all
                                    @(factors.HasChronicDisease ? "border-amber-500 bg-amber-50" : "border-gray-200 hover:border-gray-300")">
                                    <InputCheckbox @bind-Value="factors.HasChronicDisease" class="w-5 h-5 text-amber-600 rounded" />
                                    <span class="font-medium text-gray-700">🩺 بیماری مزمن</span>
                                </label>
                                <label class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all
                                    @(factors.NeedsSpecializedHealthcare ? "border-amber-500 bg-amber-50" : "border-gray-200 hover:border-gray-300")">
                                    <InputCheckbox @bind-Value="factors.NeedsSpecializedHealthcare" class="w-5 h-5 text-amber-600 rounded" />
                                    <span class="font-medium text-gray-700">🏥 نیاز به مراقبت‌های ویژه</span>
                                </label>
                            </div>
                        </StepSection>
                    }

                    @* ===== Step 6: Social & Cultural ===== *@
                    @if (currentStep == 5)
                    {
                        <StepSection Icon="🤝" Title="اجتماعی و فرهنگی" Subtitle="ترجیحات فرهنگی و اجتماعی خود را مشخص کنید">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="ترجیح فرهنگی" Icon="🎭">
                                    <InputSelect @bind-Value="factors.CulturalPreference" class="wizard-input">
                                        <option value="@CulturalPreference.Western">غربی</option>
                                        <option value="@CulturalPreference.Eastern">شرقی</option>
                                        <option value="@CulturalPreference.MiddleEastern">خاورمیانه‌ای</option>
                                        <option value="@CulturalPreference.Multicultural">چندفرهنگی</option>
                                        <option value="@CulturalPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="ترجیح مذهبی" Icon="🕌">
                                    <InputSelect @bind-Value="factors.ReligionPreference" class="wizard-input">
                                        <option value="@ReligionPreference.Muslim">مسلمان</option>
                                        <option value="@ReligionPreference.Christian">مسیحی</option>
                                        <option value="@ReligionPreference.Jewish">یهودی</option>
                                        <option value="@ReligionPreference.Other">سایر</option>
                                        <option value="@ReligionPreference.NoPreference">بدون ترجیح</option>
                                        <option value="@ReligionPreference.Secular">سکولار</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="اهمیت ثبات سیاسی" Icon="🏛️">
                                    <InputSelect @bind-Value="factors.ImportanceOfPoliticalStability" class="wizard-input">
                                        <option value="@ImportanceOfPoliticalStability.NotImportant">مهم نیست</option>
                                        <option value="@ImportanceOfPoliticalStability.SomewhatImportant">تا حدی مهم</option>
                                        <option value="@ImportanceOfPoliticalStability.Important">مهم</option>
                                        <option value="@ImportanceOfPoliticalStability.VeryImportant">خیلی مهم</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="ترجیح جامعه" Icon="👥">
                                    <InputSelect @bind-Value="factors.CommunityPreference" class="wizard-input">
                                        <option value="@CommunityIntegrationPreference.LargeIranianCommunity">جامعه بزرگ ایرانی</option>
                                        <option value="@CommunityIntegrationPreference.SmallIranianCommunity">جامعه کوچک ایرانی</option>
                                        <option value="@CommunityIntegrationPreference.NoPreference">بدون ترجیح</option>
                                        <option value="@CommunityIntegrationPreference.PreferDiverseCommunity">ترجیح جامعه متنوع</option>
                                    </InputSelect>
                                </FormField>
                            </div>
                            <div class="mt-5 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <InputCheckbox @bind-Value="factors.HasRelativesAbroad" class="w-5 h-5 text-indigo-600 rounded" />
                                    <span class="font-medium text-gray-700">👨‍👩‍👧‍👦 خویشاوندان در خارج دارم</span>
                                </label>
                                @if (factors.HasRelativesAbroad)
                                {
                                    <div class="mt-3">
                                        <InputText @bind-Value="factors.RelativesCountries" class="wizard-input" placeholder="کشورهای محل اقامت خویشاوندان" />
                                    </div>
                                }
                            </div>
                        </StepSection>
                    }

                    @* ===== Step 7: Goals & Preferences ===== *@
                    @if (currentStep == 6)
                    {
                        <StepSection Icon="🎯" Title="اهداف و ترجیحات" Subtitle="اهداف مهاجرتی و ترجیحات جغرافیایی خود را مشخص کنید">
                            <div class="mb-6">
                                <h4 class="text-sm font-semibold text-gray-500 mb-3">اهداف اصلی (چند مورد انتخاب کنید)</h4>
                                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                    @foreach (var goal in Enum.GetValues<MigrationGoal>())
                                    {
                                        var isChecked = factors.Goals.Contains(goal);
                                        <label class="flex items-center gap-2 p-3 rounded-xl border-2 cursor-pointer transition-all text-sm
                                            @(isChecked ? "border-indigo-500 bg-indigo-50 text-indigo-700" : "border-gray-200 hover:border-gray-300 text-gray-600")">
                                            <input type="checkbox" class="w-4 h-4 text-indigo-600 rounded" checked="@isChecked"
                                                   @onchange="@(e => ToggleGoal(goal, (bool)e.Value!))" />
                                            @GetGoalName(goal)
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <FormField Label="زمان‌بندی ترجیحی" Icon="⏰">
                                    <InputSelect @bind-Value="factors.PreferredTimeline" class="wizard-input">
                                        <option value="@MigrationTimeline.Immediate">فوری</option>
                                        <option value="@MigrationTimeline.Within3Months">تا ۳ ماه</option>
                                        <option value="@MigrationTimeline.Within6Months">تا ۶ ماه</option>
                                        <option value="@MigrationTimeline.Within1Year">تا ۱ سال</option>
                                        <option value="@MigrationTimeline.Within2Years">تا ۲ سال</option>
                                        <option value="@MigrationTimeline.Flexible">انعطاف‌پذیر</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="ترجیح آب‌وهوا" Icon="🌤️">
                                    <InputSelect @bind-Value="factors.ClimatePreference" class="wizard-input">
                                        <option value="@ClimatePreference.Tropical">گرمسیری</option>
                                        <option value="@ClimatePreference.Temperate">معتدل</option>
                                        <option value="@ClimatePreference.Mediterranean">مدیترانه‌ای</option>
                                        <option value="@ClimatePreference.Continental">قاره‌ای</option>
                                        <option value="@ClimatePreference.Cold">سرد</option>
                                        <option value="@ClimatePreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="شهری/روستایی" Icon="🏙️">
                                    <InputSelect @bind-Value="factors.UrbanRuralPreference" class="wizard-input">
                                        <option value="@UrbanRuralPreference.BigCity">شهر بزرگ</option>
                                        <option value="@UrbanRuralPreference.MediumCity">شهر متوسط</option>
                                        <option value="@UrbanRuralPreference.SmallTown">شهر کوچک</option>
                                        <option value="@UrbanRuralPreference.Rural">روستا</option>
                                        <option value="@UrbanRuralPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </FormField>
                                <FormField Label="فاصله از ایران" Icon="📏">
                                    <InputSelect @bind-Value="factors.DistancePreference" class="wizard-input">
                                        <option value="@DistanceFromIranPreference.VeryClose">خیلی نزدیک</option>
                                        <option value="@DistanceFromIranPreference.Close">نزدیک</option>
                                        <option value="@DistanceFromIranPreference.Moderate">متوسط</option>
                                        <option value="@DistanceFromIranPreference.Far">دور</option>
                                        <option value="@DistanceFromIranPreference.NoPreference">بدون ترجیح</option>
                                    </InputSelect>
                                </FormField>
                            </div>
                            <label class="flex items-center gap-3 mt-5 p-4 rounded-xl border-2 cursor-pointer transition-all
                                @(factors.SeekingCitizenship ? "border-green-500 bg-green-50" : "border-gray-200 hover:border-gray-300")">
                                <InputCheckbox @bind-Value="factors.SeekingCitizenship" class="w-5 h-5 text-green-600 rounded" />
                                <span class="font-medium text-gray-700">🛂 به دنبال دریافت تابعیت هستم</span>
                            </label>
                            @if (factors.NumberOfChildren > 0)
                            {
                                <div class="mt-5 p-4 bg-violet-50/50 rounded-xl border border-violet-100">
                                    <h4 class="text-sm font-semibold text-violet-600 mb-3">👨‍👩‍👧‍👦 فرزندان و آموزش</h4>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <label class="flex items-center gap-3 cursor-pointer">
                                            <InputCheckbox @bind-Value="factors.ChildrenEducationImportant" class="w-5 h-5 text-violet-600 rounded" />
                                            <span class="text-sm text-gray-700">آموزش فرزندان مهم است</span>
                                        </label>
                                        <FormField Label="سن بزرگترین فرزند" Icon="">
                                            <InputSelect @bind-Value="factors.EldestChildAge" class="wizard-input">
                                                <option value="@AgeGroup.Infant">نوزاد (۰-۲)</option>
                                                <option value="@AgeGroup.Child">کودک (۳-۱۲)</option>
                                                <option value="@AgeGroup.Teenager">نوجوان (۱۳-۱۷)</option>
                                                <option value="@AgeGroup.YoungAdult">جوان (۱۸-۲۵)</option>
                                                <option value="@AgeGroup.Adult">بزرگسال (+۲۵)</option>
                                            </InputSelect>
                                        </FormField>
                                    </div>
                                </div>
                            }
                        </StepSection>
                    }
                </div>

                <!-- Navigation Buttons -->
                <div class="border-t border-gray-100 px-6 md:px-8 py-4 bg-gray-50/50 flex justify-between items-center">
                    @if (currentStep > 0)
                    {
                        <button type="button" @onclick="PrevStep"
                                class="flex items-center gap-2 px-5 py-2.5 text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all font-medium text-sm">
                            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
                            مرحله قبل
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }

                    @if (currentStep < TotalSteps - 1)
                    {
                        <button type="button" @onclick="NextStep"
                                class="flex items-center gap-2 px-6 py-2.5 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-all font-medium text-sm shadow-lg shadow-indigo-200">
                            مرحله بعد
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
                        </button>
                    }
                    else
                    {
                        <button type="submit" @onclick="HandleSubmit"
                                class="flex items-center gap-2 px-8 py-3 bg-gradient-to-l from-green-500 to-emerald-600 text-white rounded-xl hover:from-green-600 hover:to-emerald-700 transition-all font-bold text-sm shadow-lg shadow-green-200">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            دریافت پیشنهادات مهاجرتی
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@* ===== Wizard Components ===== *@

@code {
    private UserFactors factors = new();
    private int currentStep = 0;
    private const int TotalSteps = 7;

    private static readonly string[] StepTitles = new[]
    {
        "اطلاعات شخصی",
        "تحصیلات و زبان",
        "شغل و تخصص",
        "وضعیت مالی",
        "سلامت و روان",
        "اجتماعی و فرهنگی",
        "اهداف و ترجیحات"
    };

    protected override void OnInitialized()
    {
        if (AppState.UserFactors.Age > 0)
        {
            factors = AppState.UserFactors;
        }
    }

    private void NextStep()
    {
        if (currentStep < TotalSteps - 1)
            currentStep++;
    }

    private void PrevStep()
    {
        if (currentStep > 0)
            currentStep--;
    }

    private void GoToStep(int step)
    {
        if (step <= currentStep)
            currentStep = step;
    }

    private void ToggleGoal(MigrationGoal goal, bool isChecked)
    {
        if (isChecked && !factors.Goals.Contains(goal))
            factors.Goals.Add(goal);
        else if (!isChecked && factors.Goals.Contains(goal))
            factors.Goals.Remove(goal);
    }

    private string GetGoalName(MigrationGoal goal) => goal switch
    {
        MigrationGoal.BetterEconomicOpportunities => "💵 فرصت اقتصادی",
        MigrationGoal.HigherQualityOfLife => "✨ کیفیت زندگی",
        MigrationGoal.Education => "🎓 تحصیل",
        MigrationGoal.CareerGrowth => "📈 رشد شغلی",
        MigrationGoal.FamilyReunification => "👨‍👩‍👧 پیوند خانواده",
        MigrationGoal.PoliticalStability => "🏛️ ثبات سیاسی",
        MigrationGoal.Safety => "🛡️ امنیت",
        MigrationGoal.Healthcare => "🏥 بهداشت",
        MigrationGoal.Retirement => "🌴 بازنشستگی",
        MigrationGoal.BusinessExpansion => "🏪 توسعه کسب‌وکار",
        MigrationGoal.CulturalExperience => "🎭 تجربه فرهنگی",
        _ => goal.ToString()
    };

    private void HandleSubmit()
    {
        AppState.UserFactors = factors;
        AppState.Results = AdvisorService.GetRecommendations(factors);
        NavigationManager.NavigateTo("/results");
    }
}
