<MudPaper Class="pa-3 text-center" Elevation="1">
    <MudText Typo="Typo.h5">@Icon</MudText>
    <MudText Typo="Typo.caption" Class="text-grey mt-1">@Label</MudText>
    <MudText Typo="Typo.body2" Class="font-weight-bold">@Value</MudText>
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}
