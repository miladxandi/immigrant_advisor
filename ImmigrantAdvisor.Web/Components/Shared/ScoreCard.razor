<MudPaper Class="pa-3 text-center" Elevation="1">
    <MudProgressLinear Color="@GetMudColor" Value="@Score" Rounded="true" Class="mb-2" />
    <MudText Typo="Typo.caption" Class="text-grey">@Label</MudText>
    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="@($"color: {GetHexColor}")">@Score</MudText>
</MudPaper>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Score { get; set; }
    [Parameter] public string Color { get; set; } = "blue";

    private MudBlazor.Color GetMudColor => Color switch
    {
        "green" => MudBlazor.Color.Success,
        "blue" => MudBlazor.Color.Primary,
        "yellow" => MudBlazor.Color.Warning,
        "purple" => MudBlazor.Color.Secondary,
        _ => MudBlazor.Color.Info
    };

    private string GetHexColor => Color switch
    {
        "green" => "#4caf50",
        "blue" => "#1976d2",
        "yellow" => "#ed6c02",
        "purple" => "#9c27b0",
        _ => "#3f51b5"
    };
}
